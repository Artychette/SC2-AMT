        <Element Type="CustomScript" Id="CE8629BC">
            <ScriptCode>
                void libAMT_gf_TriggerAddEventCinematicModeChange(trigger t,bool OnOff)
                {   
                    if(OnOff)
                    {   
                        TriggerAddEventGeneric(t, &quot;CinematicModeOn&quot;);
                    }
                    else
                    {
                        TriggerAddEventGeneric(t, &quot;CinematicModeOff&quot;);
                    }
                }
                void libAMT_gf_TriggerAddEventCinematicModeChangeForPlayer(trigger t, int player, int mode)
                {
                    int i;
                    if(player == c_playerAny)
                    {
                        i=0;
                    }
                    else
                    {
                        i=player;
                        player += 1;
                    }
                    for(;i&lt;player;i+=1)
                    {
                        if(i&lt;10)
                        {
                            if((mode==0)||(mode==2))
                            {
                                TriggerAddEventGeneric(t,&quot;AMTCinematicModeOff0&quot;+IntToString(i));
                            }            
                            if((mode==1)||(mode==2))
                            {
                                TriggerAddEventGeneric(t,&quot;AMTCinematicModeOOn0&quot;+IntToString(i));
                            } 
                        }
                        else
                        {
                            if((mode==0)||(mode==2))
                            {
                                TriggerAddEventGeneric(t,&quot;AMTCinematicModeOff&quot;+IntToString(i));
                            }            
                            if((mode==1)||(mode==2))
                            {
                                TriggerAddEventGeneric(t,&quot;AMTCinematicModeOOn&quot;+IntToString(i));
                            } 
                        }
                    }
                }
                int libAMT_gf_EventCinematicCinematicModeChange()
                {
                    string subs = StringSub(EventGenericName(),17,19);
                    if(subs==&quot;OOn&quot;)
                    {
                        return 1;
                    }
                    else
                    {
                        return 0;
                    }
                }
                int libAMT_gf_EventPlayerCinematicModeChange()
                {
                    return StringToInt(StringSub(EventGenericName(),20,21));
                }
            </ScriptCode>
