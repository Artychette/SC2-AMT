        <Element Type="FunctionDef" Id="6FF20D2B">
            <Identifier>ForEachNodeInConvTree</Identifier>
            <Label Type="Label" Library="Ntve" Id="00000034"/>
            <FlagAction/>
            <FlagSubFunctions/>
            <FlagAllowBreak/>
            <Parameter Type="ParamDef" Library="B513D0A0" Id="936763B0"/>
            <Parameter Type="ParamDef" Library="B513D0A0" Id="0376BC1A"/>
            <SubFunctionType Type="SubFuncType" Library="B513D0A0" Id="4740B3EE"/>
            <ScriptCode>
                #AUTOVAR(PNameStack,libAMT_VectorRef) = #PARAM(conversationTree).lv_parentStack;
                #AUTOVAR(PIDStack,libAMT_VectorRef) = #PARAM(conversationTree).lv_iDStack;
                #AUTOVAR(CIDStack,libAMT_VectorRef) = #PARAM(conversationTree).lv_childIDStack;
                for(;;)
                {
                    if(#AUTOVAR(PNameStack).lv_size == 0) //parent stack is empty, just quit
                    { break; }
                    
                    // next child ID query
                    #AUTOVAR(childID,int) = DataTableGetInt(
                                            #AUTOVAR(CIDStack).lv_scope,
                                            #AUTOVAR(CIDStack).lv_id_prefix+IntToString(
                                                #AUTOVAR(CIDStack).lv_size-1
                                                )
                                            )+1;
                    // catalog field from parent type
                    #AUTOVAR(field,string) = DataTableGetString(
                                        #AUTOVAR(PNameStack).lv_scope,
                                        #AUTOVAR(PNameStack).lv_id_prefix+IntToString(
                                            #AUTOVAR(PNameStack).lv_size-1
                                            )
                                        );
                        
                    if(#AUTOVAR(field) != &quot;RootItems&quot;)
                    {
                        // not root item : make it &quot;field[X].Children&quot;
                        #AUTOVAR(field) = #AUTOVAR(field) + 
                                          &quot;[&quot; + 
                                          IntToString(
                                              DataTableGetInt(
                                                  #AUTOVAR(PIDStack).lv_scope,
                                                  #AUTOVAR(PIDStack).lv_id_prefix+IntToString(
                                                    #AUTOVAR(PIDStack).lv_size-1
                                                    )
                                                  )
                                          ) + 
                                          &quot;].Children&quot;;
                       
                    }        
                    #AUTOVAR(childCount,int) = CatalogFieldValueCount(c_gameCatalogConversation, #PARAM(conversationTree).lv_convLink, #AUTOVAR(field), #PARAM(conversationTree).lv_player);
                    if (#AUTOVAR(childID) == 0) // Expanding a Group/Choice, check if there is any child, select the first if so
                    {
                        if (#AUTOVAR(childCount) == 0) // Group/Choice node has no child
                        {
                            //pop the stacks and continue
                            #AUTOVAR(PNameStack).lv_size -= 1;
                            DataTableValueRemove(#PARAM(conversationTree).lv_scope,#AUTOVAR(PNameStack).lv_id_prefix+IntToString(#AUTOVAR(PNameStack).lv_size));
                            #AUTOVAR(PIDStack).lv_size -= 1;
                            DataTableValueRemove(#PARAM(conversationTree).lv_scope,#AUTOVAR(PIDStack).lv_id_prefix+IntToString(#AUTOVAR(PIDStack).lv_size));
                            #AUTOVAR(CIDStack).lv_size -= 1;
                            DataTableValueRemove(#PARAM(conversationTree).lv_scope,#AUTOVAR(CIDStack).lv_id_prefix+IntToString(#AUTOVAR(CIDStack).lv_size));
                            
                            continue;
                        }
                        else 
                        {   
                             //setup the first child
                            DataTableSetInt(#PARAM(conversationTree).lv_scope,#AUTOVAR(CIDStack).lv_id_prefix+IntToString(#AUTOVAR(CIDStack).lv_size-1), 0);
                            #AUTOVAR(nodeID,string) = CatalogFieldValueGet(c_gameCatalogConversation, #PARAM(conversationTree).lv_convLink, #AUTOVAR(field) + &quot;[0]&quot;, c_playerAny);
                        }
                    }
                    else // keep exploring the Group/Choice
                    {
                        if (#AUTOVAR(childCount) == #AUTOVAR(childID)) // run out of children
                        {
                            //pop the stacks and continue
                            #AUTOVAR(PNameStack).lv_size -= 1;
                            DataTableValueRemove(#PARAM(conversationTree).lv_scope,#AUTOVAR(PNameStack).lv_id_prefix+IntToString(#AUTOVAR(PNameStack).lv_size));
                            #AUTOVAR(PIDStack).lv_size -= 1;
                            DataTableValueRemove(#PARAM(conversationTree).lv_scope,#AUTOVAR(PIDStack).lv_id_prefix+IntToString(#AUTOVAR(PIDStack).lv_size));
                            #AUTOVAR(CIDStack).lv_size -= 1;
                            DataTableValueRemove(#PARAM(conversationTree).lv_scope,#AUTOVAR(CIDStack).lv_id_prefix+IntToString(#AUTOVAR(CIDStack).lv_size));
                            
                            continue;
                        }
                        else 
                        {
                             //setup the next child
                            DataTableSetInt(#PARAM(conversationTree).lv_scope,#AUTOVAR(CIDStack).lv_id_prefix+IntToString(#AUTOVAR(CIDStack).lv_size-1), #AUTOVAR(childID));
                            #AUTOVAR(nodeID) = CatalogFieldValueGet(c_gameCatalogConversation,#PARAM(conversationTree).lv_convLink,#AUTOVAR(field) + &quot;[&quot; + IntToString(#AUTOVAR(childID)) + &quot;]&quot;, c_playerAny);
                        }
                    }
                    // prep the iterator
                    #PARAM(conversationNode).lv_type = DataTableGetString(#PARAM(conversationTree).lv_scope,&quot;AMT_CONVMAPTYPE&quot;+#PARAM(conversationTree).serial+&quot;_&quot;+#AUTOVAR(nodeID));
                    #PARAM(conversationNode).lv_iD = DataTableGetInt(#PARAM(conversationTree).lv_scope,&quot;AMT_CONVMAPID&quot;+#PARAM(conversationTree).serial+&quot;_&quot;+#AUTOVAR(nodeID));
                    
                    if( StringEqual(#PARAM(conversationNode).lv_type,&quot;Groups&quot;,c_stringCase) 
                        ||
                        StringEqual(#PARAM(conversationNode).lv_type,&quot;Choices&quot;,c_stringCase)
                      )
                    {
                        // child node is a group or a user choice
                        // -&gt; push it into the stack
                        DataTableSetString(#PARAM(conversationTree).lv_scope,#AUTOVAR(PNameStack).lv_id_prefix+IntToString(#AUTOVAR(PNameStack).lv_size),#PARAM(conversationNode).lv_type);
                        #AUTOVAR(PNameStack).lv_size += 1;
                        DataTableSetInt(#PARAM(conversationTree).lv_scope,#AUTOVAR(PIDStack).lv_id_prefix+IntToString(#AUTOVAR(PIDStack).lv_size),#PARAM(conversationNode).lv_iD);
                        #AUTOVAR(PIDStack).lv_size += 1;
                        DataTableSetInt(#PARAM(conversationTree).lv_scope,#AUTOVAR(CIDStack).lv_id_prefix+IntToString(#AUTOVAR(CIDStack).lv_size),-1);
                        #AUTOVAR(CIDStack).lv_size += 1;
                    }
                    // call subfunctions
                    #SUBFUNCS(actions)
                }
            </ScriptCode>
        </Element>
