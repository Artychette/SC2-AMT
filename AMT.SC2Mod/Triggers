            <Parameter Type="ParamDef" Library="B513D0A0" Id="50E31699"/>
            <Parameter Type="ParamDef" Library="B513D0A0" Id="668ED24F"/>
            <ScriptCode>
                // break exploration loop if outside the given choice #PARAM(choiceID) branch
                #AUTOVAR(i,int) = #PARAM(conversationTree).lv_parentStack.lv_size-1;
                #AUTOVAR(break,bool) = true;
                for ( ; #AUTOVAR(i) &gt;= 0 ; #AUTOVAR(i) -= 1 ) {
                    if( (DataTableGetString(#PARAM(conversationTree).lv_scope,#PARAM(conversationTree).lv_parentStack.lv_id_prefix+IntToString(#AUTOVAR(i))) == &quot;Choices&quot;) &amp;&amp; (DataTableGetInt(#PARAM(conversationTree).lv_scope,#PARAM(conversationTree).lv_iDStack.lv_id_prefix+IntToString(#AUTOVAR(i))) == #PARAM(choiceID)))
                    {
                        #AUTOVAR(break) = false;
                        break;
                    }
                }
                if(#AUTOVAR(break)){ #SMARTBREAK }
            </ScriptCode>
        </Element>
