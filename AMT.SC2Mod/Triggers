                //
                // Vector Global Definitions
                //
                void libAMT_Vector_clear(libAMT_VectorRef vec)
                {   
                    int i;
                    int size = vec.lv_size;
                    for(i=0; i&lt;size;i+=1)
                    {
                       DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
                    }
                    DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,0);
                    vec.lv_size=0;
                }
                void libAMT_Vector_pop_back(libAMT_VectorRef vec)
                {   
                    int lv_size = vec.lv_size;
                    if(lv_size&gt;0)
                    {
                        lv_size-=1;
                        DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size));
                        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
                    }
                }
                void libAMT_Vector_delete(libAMT_VectorRef vec)
                {   
                    int i;
                    int size = vec.lv_size;
                    if(vec.lv_id_prefix == null || vec.lv_id_prefix == &quot;&quot;){ return; }
                    for(i=0; i&lt;size;i+=1)
                    {
                       DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
                    }
                    DataTableValueRemove(vec.lv_scope,vec.lv_size_prefix);
                }
                void libAMT_Vector_resize(int size,libAMT_VectorRef vec)
                {   
                    int i;
                    int lv_size = vec.lv_size;
                    if(size&lt;0){ size=0; }
                    if(lv_size == size){ return; }
                    if(lv_size &gt; size)
                    {
                        for(i=size; i&lt;lv_size; i+=1)
                        {   
                            DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
                        }
                    }
                    DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,size);
                    vec.lv_size = size;
                }
                void libAMT_Vector_swap(libAMT_VectorRef A, libAMT_VectorRef B)
                {
                    string buff = A.lv_id;
                    bool scopebuff = A.lv_scope;
                    int size = A.lv_size;
                    A.lv_id = B.lv_id;
                    B.lv_id = buff;
                    buff = A.lv_id_prefix;
                    A.lv_id_prefix = B.lv_id_prefix;
                    B.lv_id_prefix = buff;
                    buff = A.lv_size_prefix;
                    A.lv_size_prefix = B.lv_size_prefix;
                    B.lv_size_prefix = buff;
                    A.lv_scope = B.lv_scope;
                    B.lv_scope = scopebuff;
                    A.lv_size = B.lv_size;
                    B.lv_size = size;
                }
                void libAMT_Vector_setscope(bool scope,libAMT_VectorRef vec)
                {
                    vec.lv_scope = scope;
                }
                void libAMT_DataTableSetVector(string name,libAMT_VectorRef vec)
                {
                    DataTableSetString(vec.lv_scope,name,vec.lv_id);
                }
                void libAMT_DataTableGetVector(bool scope,string name,libAMT_VectorRef vec)
                {
                    string vec_id = DataTableGetString(scope,name);
                    string size_id = AMTVEC_SIZE_PREFIX+vec_id;
                    if(!DataTableValueExists(scope,size_id))
                    { return; }
                    vec.lv_id = vec_id;
                    vec.lv_id_prefix = AMTVEC_ID_PREFIX+vec_id;
                    vec.lv_size_prefix = size_id;
                    vec.lv_scope = scope;
                    vec.lv_size = DataTableGetInt(scope,size_id);
                }
