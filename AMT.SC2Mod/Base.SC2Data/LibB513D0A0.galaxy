        for(j=src.lv_start; j<src_size+src.lv_start; j+=1)
        {   
            DataTableSetPing(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetPing(src.lv_scope,src.lv_id_prefix+IntToString(j)));
            i+=1;
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,src_size);
        tar.lv_size = src_size;
    }
    //
    // DATATABLE REF portrait 
    //
    funcref<DataTableGetPortrait> libAMT_DataTableGetportrait_Ref = DataTableGetPortrait;
