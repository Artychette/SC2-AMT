    // Automatic Variable Declarations
    int auto8C459864_ae;
    int auto8C459864_var;

    // Variable Initialization
    lv_workingGroup = UnitGroupEmpty();
    lv_removeCheck = true;

    // Conditions
    if (testConds) {
        if (!((PlayerGroupHasPlayer(libB513D0A0_gv_aMT_ProductionQueueUsers, EventPlayer()) == true))) {
