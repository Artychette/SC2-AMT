    void libAMT_Vectorunit_append(libAMT_VectorRef src, libAMT_VectorRef tar)
    {
        int i;
        int j;
        int src_size = src.lv_size;
        int tar_size = tar.lv_size;
        i = tar_size;
        for(j=0; j<src_size; j+=1)
        {   
            DataTableSetUnit(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetUnit(src.lv_scope,src.lv_id_prefix+IntToString(j)));
            i+=1;
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,tar_size+src_size);
        tar.lv_size += src_size;
    }
    //
    // DEQueue<unit> Definitions 
    //
    void libAMT_Dequeunit_new(int size, unit value,bool scope, libAMT_DequeRef que)
    {   
        libAMT_Deque new_que;
        int i;
        int lv_size = MaxI(0,size);
        string id_suffix;
        // clear old storage
        new_que.lv_id = que.lv_id;
        new_que.lv_id_prefix = que.lv_id_prefix;
        new_que.lv_size_prefix = que.lv_size_prefix;
        new_que.lv_start_prefix = que.lv_start_prefix;
        new_que.lv_scope = que.lv_scope;
        new_que.lv_size = que.lv_size;
        new_que.lv_start = que.lv_start;
        libAMT_Deque_delete(new_que);
        // Generate new ID
        AMTVEC_RANDOM_NAME_SEED = 1664525*AMTDEQ_RANDOM_NAME_SEED + 1013904223; // Knuth's LCG magic numbers
        que.lv_id = libAMT_CodeIntToString(AMTDEQ_RANDOM_NAME_SEED)+"_";
        que.lv_id_prefix = AMTDEQ_ID_PREFIX+que.lv_id;
        que.lv_size_prefix = AMTDEQ_SIZE_PREFIX+que.lv_id;
        que.lv_start_prefix = AMTDEQ_START_PREFIX+que.lv_id;
        que.lv_scope = scope;
        que.lv_size = lv_size;
        que.lv_start = 0;
        //init new container
        DataTableSetInt(scope,que.lv_size_prefix,lv_size);
        DataTableSetInt(scope,que.lv_start_prefix,0);
        for(i=0; i<lv_size;i+=1)
        {
            DataTableSetUnit(scope,que.lv_id_prefix+IntToString(i),value);
        }
    }
