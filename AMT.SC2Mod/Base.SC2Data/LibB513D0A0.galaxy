// Trigger: Damage Type Auto Update
//--------------------------------------------------------------------------------------------------
bool libB513D0A0_gt_DamageTypeAutoUpdate_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_effect;
    string lv_type;
    int lv_player;

    // Automatic Variable Declarations
    int auto26E1AA02_catalog;
    int auto26E1AA02_i;
    const int auto844FF86C_ae = 15;
    const int auto844FF86C_ai = 1;
    string auto9DF99E55_val;

    // Variable Initialization
    lv_type = "Unknown";

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    auto26E1AA02_catalog = c_gameCatalogEffect;
    auto26E1AA02_i = 1;
    for ( ; auto26E1AA02_i <= CatalogEntryCount(c_gameCatalogEffect) ; auto26E1AA02_i += 1 ) {
        lv_effect = CatalogEntryGet(auto26E1AA02_catalog, auto26E1AA02_i);
        if ((CatalogEntryScope(c_gameCatalogEffect, lv_effect) == "CEffectDamage")) {
            lv_player = 0;
            for ( ; ( (auto844FF86C_ai >= 0 && lv_player <= auto844FF86C_ae) || (auto844FF86C_ai < 0 && lv_player >= auto844FF86C_ae) ) ; lv_player += auto844FF86C_ai ) {
                if ((CatalogFieldValueGet(c_gameCatalogEffect, lv_effect, "Type", lv_player) == ("Unknown"))) {
                    auto9DF99E55_val = CatalogFieldValueGet(c_gameCatalogEffect, lv_effect, "Death", lv_player);
                    if (auto9DF99E55_val == "Blast") {
                        lv_type = "Demolition";
                    }
                    else if (auto9DF99E55_val == "Desintegrate") {
                        lv_type = "Acid";
                    }
                    else if (auto9DF99E55_val == "Electrocute") {
                        lv_type = "Lightning";
                    }
                    else if (auto9DF99E55_val == "Evicerate") {
                        lv_type = "ShadowStrike";
                    }
                    else if (auto9DF99E55_val == "Fire") {
                        lv_type = "Fire";
                    }
                    else if (auto9DF99E55_val == "Freeze") {
                        lv_type = "Cold";
                    }
                    else if (auto9DF99E55_val == "Impact") {
                        lv_type = "Force";
                    }
                    else if (auto9DF99E55_val == "Normal") {
                        lv_type = "Normal";
                    }
                    else if (auto9DF99E55_val == "Salvage") {
                        lv_type = "ShadowStrike";
                    }
                    else if (auto9DF99E55_val == "SilentKill") {
                        lv_type = "ShadowStrike";
                    }
                    else if (auto9DF99E55_val == "Squish") {
                        lv_type = "Force";
                    }
                    else if (auto9DF99E55_val == "Unlink") {
                        lv_type = "SpiritLink";
                    }
                    else {
                        lv_type = "Unknown";
                    }
                    CatalogFieldValueSet(c_gameCatalogEffect,lv_effect, "Type", lv_player, lv_type);
                }

            }
        }

    }
    return true;
}

