        }

        if (!((DataTableValueExists(true, ("AMT_PQP_Exclude_P" + IntToString(EventPlayer()) + "_" + (UnitGetType(EventUnit())) + "_" + (libNtve_gf_TriggeringProgressUpgrade()))) == false))) {
