void libAMT_gf_Rand_SetSeed(int seed)
{
    libAMT_gv_Rand_unifi_seed = seed;
    libAMT_gv_Rand_uniff_seed = ~seed;
    libAMT_gv_Rand_unifiFG_seed = 0xFFFF&((seed>>3)^0xA555);
    if(libAMT_gv_Rand_unifiFG_seed == 0)
    {libAMT_gv_Rand_unifiFG_seed = 0x10000;}
}
