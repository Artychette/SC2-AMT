// Custom Script
//--------------------------------------------------------------------------------------------------
// Custom Script: Cinematic Mode On/Off Implementation
//--------------------------------------------------------------------------------------------------
void libAMT_gf_TriggerAddEventCinematicModeChange(trigger t,bool OnOff)
{   
    if(OnOff)
    {   
        TriggerAddEventGeneric(t, "CinematicModeOn");
    }
    else
    {
        TriggerAddEventGeneric(t, "CinematicModeOff");
    }
}
void libAMT_gf_TriggerAddEventCinematicModeChangeForPlayer(trigger t, int player, int mode)
{
    int i;
    if(player == c_playerAny)
    {
        i=0;
    }
    else
    {
        i=player;
        player += 1;
    }
    for(;i<player;i+=1)
    {
        if(i<10)
        {
            if((mode==0)||(mode==2))
            {
                TriggerAddEventGeneric(t,"AMTCinematicModeOff0"+IntToString(i));
            }            
            if((mode==1)||(mode==2))
            {
                TriggerAddEventGeneric(t,"AMTCinematicModeOOn0"+IntToString(i));
            } 
        }
        else
        {
            if((mode==0)||(mode==2))
            {
                TriggerAddEventGeneric(t,"AMTCinematicModeOff"+IntToString(i));
            }            
            if((mode==1)||(mode==2))
            {
                TriggerAddEventGeneric(t,"AMTCinematicModeOOn"+IntToString(i));
            } 
        }
    }
}
int libAMT_gf_EventCinematicCinematicModeChange()
{
    string subs = StringSub(EventGenericName(),17,19);
    if(subs=="OOn")
    {
        return 1;
    }
    else
    {
        return 0;
    }
}
int libAMT_gf_EventPlayerCinematicModeChange()
{
    return StringToInt(StringSub(EventGenericName(),20,21));
}

//--------------------------------------------------------------------------------------------------
// Custom Script: Player Property Changed (AMT) Implementation
//--------------------------------------------------------------------------------------------------
void libAMT_gf_TriggerAddEventPlayerPropChange(trigger t,int player, int property)
{   
    int i;
    if(player == c_playerAny)
    {   
        for(i=0; i<16; i+=1)
        {
            TriggerAddEventPlayerPropChange(t,i,property);
        }
    }
    else
    {
        TriggerAddEventPlayerPropChange(t,player,property);
    }
}

//--------------------------------------------------------------------------------------------------
// Custom Script: Top Bar Energy Property Change Implementation
//--------------------------------------------------------------------------------------------------
void libAMT_gf_TriggerAddEventTopBarEnergyPropChange(trigger t,string template,int prop)
{
    
    string eventName = "AMTEventTopBarPropertyEnergyChange ";
    int i;
   
    if (prop == c_unitPropEnergy) 
    {
        eventName = (eventName + "Current");
    }
    else if (prop == c_unitPropEnergyMax) 
    {
         eventName = (eventName + "Max");
    }
    else if (prop == c_unitPropEnergyRegen) 
    {
        eventName = (eventName + "Regen");
    }
    else {
        return;
    }
    eventName = (eventName + " ");
    TriggerAddEventGeneric(t,eventName+IntToString(i)+" "+template);
}
int libAMT_gf_EventPlayerTopBar()
{
    return StringToInt(StringWord(EventGenericName(),3));
}
int libAMT_gf_EventPropTopBarEnergyPropChange()
{
    string eventName = EventGenericName();
    string prop = StringWord(eventName, 2);
    if (prop == "Current") {
        return c_unitPropEnergy;
    }
    else if (prop == "Max") {
        return c_unitPropEnergyMax;
    }
    else if (prop == "Regen") {
        return c_unitPropEnergyRegen;
    }
    else {
        return -1;
    }
}
string libAMT_gf_EventUserTopBarEnergyPropChange()
{
    return StringWord(EventGenericName(),4);
}

//--------------------------------------------------------------------------------------------------
// Custom Script: Top Bar Cancel/Fire Event Implementation
//--------------------------------------------------------------------------------------------------
void libAMT_gf_TriggerAddEventTopBarCancelled(trigger t,int player,string ability)
{
    int ab_i = libNtve_gf_UserDataInstanceGetIndex("AMTTopBarExtendedAbilty",ability);
    int i;
    int ab_e;
    int ab_s;

    if(player == c_playerAny)
    {
        i = 0;
    }
    else
    {
        i = player;
        player += 1;
    }
    if(ab_i == -1 || ability == null || ability == "")
    {
        ab_i = 1;
        ab_e = UserDataInstanceCount("AMTTopBarExtendedAbilty")+1;
    }
    else
    {
        ab_e = ab_i+1;
    }
    ab_s = ab_i;
    while(i!=player)
    {
        TriggerAddEventGeneric(t,"AMTTargetingEventCancel "+UserDataInstance("AMTTopBarExtendedAbilty",ab_i)+" "+IntToString(i));
        ab_i+=1;
        if(ab_i == ab_e)
        {
            i+=1;
            ab_i = ab_s;
        }
    }
}
string libAMT_gf_EventAbilityTopBar()
{
    return StringWord(EventGenericName(),2);
}
void libAMT_gf_TriggerAddEventTopBarFired(trigger t,int player,string ability)
{
    int ab_i = libNtve_gf_UserDataInstanceGetIndex("AMTTopBarExtendedAbilty",ability);
    int i;
    int ab_e;
    int ab_s;

    if(player == c_playerAny)
    {
        i = 0;
    }
    else
    {
        i = player;
        player += 1;
    }
    if(ab_i == -1 || ability == null || ability == "")
    {
        ab_i = 1;
        ab_e = UserDataInstanceCount("AMTTopBarExtendedAbilty")+1;
    }
    else
    {
        ab_e = ab_i+1;
    }
    ab_s = ab_i;
    while(i!=player)
    {
        TriggerAddEventGeneric(t,"AMTTargetingEventFired "+UserDataInstance("AMTTopBarExtendedAbilty",ab_i)+" "+IntToString(i));
        ab_i+=1;
        if(ab_i == ab_e)
        {
            i+=1;
            ab_i = ab_s;
        }
    }
}

