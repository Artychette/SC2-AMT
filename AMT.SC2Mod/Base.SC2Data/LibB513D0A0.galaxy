        }

        if (!((DataTableValueExists(true, ("AMT_PQP_Exclude_P16_" + (UnitGetType(EventUnit())) + "_" + (libNtve_gf_TriggeringProgressUpgrade()))) == false))) {
            return false;
        }

        if (!((DataTableValueExists(true, ("AMT_PQP_Exclude_P16_any_" + (libNtve_gf_TriggeringProgressUpgrade()))) == false))) {
            return false;
        }

        if (!((DataTableValueExists(true, ("AMT_PQP_Exclude_P16_" + (UnitGetType(EventUnit())) + "_any")) == false))) {
