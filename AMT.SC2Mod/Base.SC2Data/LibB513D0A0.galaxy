void libB513D0A0_gf_SetProductionQueuePanelOrientation (bool lp_orientation, playergroup lp_players) {
    // Variable Declarations
    bool lv_setHorizontal;
    int lv_previousDialog;
    int lv_nextDialog;
    int lv_player;
    int lv_q;
    int lv_s;
    string lv_image;

    // Automatic Variable Declarations
    playergroup auto4342F740_g;

    // Variable Initialization
    lv_setHorizontal = (lp_orientation == true);
    lv_previousDialog = c_invalidDialogControlId;
    lv_nextDialog = c_invalidDialogControlId;
    lv_image = "";

    // Implementation
    if ((lv_setHorizontal == true)) {
        DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/ProductionQueueFrameV/ProductionQueuePanel");
        lv_previousDialog = DialogControlLastCreated();
        DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/ProductionQueueFrameH/ProductionQueuePanel");
        lv_nextDialog = DialogControlLastCreated();
    }
    else {
        DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/ProductionQueueFrameV/ProductionQueuePanel");
        lv_nextDialog = DialogControlLastCreated();
        DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer/ProductionQueueFrameH/ProductionQueuePanel");
        lv_previousDialog = DialogControlLastCreated();
    }
    DialogControlSetVisible(lv_previousDialog, lp_players, false);
    DialogControlSetVisible(lv_nextDialog, lp_players, true);
    auto4342F740_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto4342F740_g, lv_player);
        if (lv_player < 0) { break; }
        if ((libB513D0A0_gv_aMT_ProductionQueueLayoutOrientation[lv_player] == lv_setHorizontal)) {
            continue;
        }
        else {
            libB513D0A0_gv_aMT_ProductionQueueLayoutOrientation[lv_player] = lv_setHorizontal;
        }
        lv_s = 0;
        lv_q = 0;
        while ((lv_q < 6)) {
            if ((DataTableValueExists(true, ("AMT_PQP_P" + IntToString(lv_player) + "_Q" + IntToString(lv_q) + "_S_" + IntToString(lv_s))) == true)) {
                DialogControlHookup(lv_nextDialog, c_triggerControlTypePanel, libNtve_gf_ConvertStringToUILayoutFrameName(("Queue" + IntToString(lv_q) + "/Slot" + IntToString(lv_s))));
                DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupSingle(lv_player), true);
                DialogControlHookup(lv_previousDialog, c_triggerControlTypePanel, libNtve_gf_ConvertStringToUILayoutFrameName(("Queue" + IntToString(lv_q) + "/Slot" + IntToString(lv_s))));
                DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupSingle(lv_player), false);
                DialogControlHookup(lv_nextDialog, c_triggerControlTypePanel, libNtve_gf_ConvertStringToUILayoutFrameName(("Queue" + IntToString(lv_q) + "/Slot" + IntToString(lv_s))));
                DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupSingle(lv_player), true);
                libB513D0A0_gf_AMTPQPHelperSetSlotImage(lv_s, lv_q, lv_player, DataTableGetString(true, ("AMT_PQP_P" + IntToString(lv_player) + "_Q" + IntToString(lv_q) + "_S_" + IntToString(lv_s))), libB513D0A0_ge_AMT_PQP_ProductionTypeIconSet_Auto, libB513D0A0_ge_AMT_PQP_ShowHideSlotOption_Ignore);
            }
            else {
                DialogControlHookup(lv_nextDialog, c_triggerControlTypePanel, libNtve_gf_ConvertStringToUILayoutFrameName(("Queue" + IntToString(lv_q) + "/Slot" + IntToString(lv_s))));
                DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupSingle(lv_player), false);
            }
            lv_s += 1;
            if ((lv_s >= 10)) {
                lv_s = 0;
                lv_q += 1;
            }

        }
    }
}

