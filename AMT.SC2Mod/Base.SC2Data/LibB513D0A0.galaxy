//--------------------------------------------------------------------------------------------------
// Trigger: Clean Up Transmission
//--------------------------------------------------------------------------------------------------
bool libB513D0A0_gt_CleanUpTransmission_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_mainDialog;

    // Automatic Variable Declarations
    int auto6F33CC86_ae;
    int auto6F33CC86_var;

    // Variable Initialization
    lv_mainDialog = c_invalidDialogId;

    // Conditions
    if (testConds) {
        if (!(TriggerIsEnabled(TriggerGetCurrent()))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(libB513D0A0_gt_CommunicationButtonClicked, false);
    TriggerEnable(libB513D0A0_gt_MouseScroll, false);
    if (DataTableValueExists(true, ("ATMCOMMMainDialog"))) {
        DialogControlDestroyAll(DataTableGetDialog(true, ("ATMCOMMMainDialog")));
        DialogDestroy(DataTableGetDialog(true, ("ATMCOMMMainDialog")));
    }

    DataTableValueRemove(true, ("ATMCOMMNextButton"));
    DataTableValueRemove(true, ("ATMCOMMCurrentLine"));
    DataTableValueRemove(true, ("ATMCOMMSlider"));
    DataTableValueRemove(true, ("ATMCOMMSliderOffset"));
    DataTableValueRemove(true, ("ATMCOMMCumulHeight"));
    auto6F33CC86_ae = DataTableGetInt(true, "ShepardCommunicationLineCount");
    auto6F33CC86_var = 1;
    for ( ; auto6F33CC86_var <= auto6F33CC86_ae; auto6F33CC86_var += 1 ) {
        DataTableValueRemove(true, (("ATMCOMMLineText") + IntToString(auto6F33CC86_var)));
        DataTableValueRemove(true, (("ATMCOMMLineSpeaker") + IntToString(auto6F33CC86_var)));
        DataTableValueRemove(true, (("ATMCOMMLineLeftSided") + IntToString(auto6F33CC86_var)));
        DataTableValueRemove(true, (("ATMCOMMLineHeight") + IntToString(auto6F33CC86_var)));
        DataTableValueRemove(true, (("ATMCOMMLineSerial") + IntToString(auto6F33CC86_var)));
        DataTableValueRemove(true, (("ATMCOMMLineWriteOut") + IntToString(auto6F33CC86_var)));
        DataTableValueRemove(true, (("ATMCOMMLineWait") + IntToString(auto6F33CC86_var)));
    }
    DataTableValueRemove(true, ("ATMCOMMLineCount"));
    if ((!(DataTableValueExists(true, ("ATMCOMMCineMode"))) || !(DataTableGetBool(true, ("ATMCOMMCineMode"))))) {
        if (DataTableValueExists(true, ("ATMCOMMMainDialog"))) {
            libB513D0A0_gf_SetGlobalPause(false);
            CameraLockInput(1, false);
        }

    }
    else {
        DataTableValueRemove(true, ("ATMCOMMCineMode"));
        if (DataTableValueExists(true, ("ATMCOMMTalkIcon"))) {
            libNtve_gf_KillModel(DataTableGetActor(true, ("ATMCOMMTalkIcon")));
        }

        UISetCursorVisible(PlayerGroupAll(), false);
    }
    DataTableValueRemove(true, ("ATMCOMMMainDialog"));
    DataTableValueRemove(true, ("ATMCOMMPending"));
    return true;
}

