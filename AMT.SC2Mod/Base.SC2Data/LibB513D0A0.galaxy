    }

    lv_topOffset += (30.0 * EventMouseWheelSpin());
    lv_topOffset = MaxF((libB513D0A0_gv_innerFrameHeight - DataTableGetInt(true, ("ATMCOMMCumulHeight"))), MinF(lv_topOffset, 0.0));
