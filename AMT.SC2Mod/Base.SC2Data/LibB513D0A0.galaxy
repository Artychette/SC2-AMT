        }

        if (!((DataTableValueExists(true, ("AMT_PQP_Exclude_P" + IntToString(EventPlayer()) + "_any_" + (libNtve_gf_TriggeringProgressUpgrade()))) == false))) {
            return false;
        }

        if (!((DataTableValueExists(true, ("AMT_PQP_Exclude_P" + IntToString(EventPlayer()) + "_" + (UnitGetType(EventUnit())) + "_any")) == false))) {
            return false;
        }

        if (!((CatalogEntryIsValid(c_gameCatalogUpgrade, libNtve_gf_TriggeringProgressUpgrade()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((DataTableValueExists(true, ("AMT_PQP_P" + IntToString(EventPlayer()) + "_ProgT" + (libNtve_gf_TriggeringProgressUpgrade()))) == false)) {
        return true;
    }

    auto8C459864_ae = UnitQueueGetProperty(EventUnit(), c_unitQueuePropertyCount);
    auto8C459864_var = 1;
    for ( ; auto8C459864_var <= auto8C459864_ae; auto8C459864_var += 1 ) {
