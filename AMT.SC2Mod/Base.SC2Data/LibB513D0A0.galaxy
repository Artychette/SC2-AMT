typedef libAMTH_gs_ConversationPlayer SConvPlayer;
SConvPlayer libAMT_ConvTransmissionPlayer;
SConvPlayer libAMT_ConvScrolledDialogPlayer;
SConvPlayer libAMT_ConvBriefingPlayer;
void libAMT_ConvInitDefaultPlayers()
{
    libAMT_ConvTransmissionPlayer.skipPrompt = libAMT_ConvDefaultSkipPromptCallback;
    libAMT_ConvTransmissionPlayer.init = libAMT_ConvDefaultInitCallback;
    libAMT_ConvTransmissionPlayer.close = libAMT_ConvDefaultCloseCallback;
    libAMT_ConvTransmissionPlayer.runLine = libB513D0A0_gf_RunLineTransmission;
    libAMT_ConvTransmissionPlayer.runChoice = libAMT_ConvDefaultChoiceCallback;
    libAMT_ConvTransmissionPlayer.checkCondition = libAMT_ConvCheckNodeConditionsGeneric;
    libAMT_ConvTransmissionPlayer.runAction = libAMT_ConvRunNodeActionsGeneric;
    libAMT_ConvTransmissionPlayer.UITemplate = null;
    libAMT_ConvScrolledDialogPlayer.skipPrompt = libAMT_ConvSkipPromptGeneric;
    libAMT_ConvScrolledDialogPlayer.init = libB513D0A0_gf_InitScrolledWindow;
    libAMT_ConvScrolledDialogPlayer.close = libB513D0A0_gf_CloseScrolledWindow;
    libAMT_ConvScrolledDialogPlayer.runLine = libB513D0A0_gf_RunLineScrolledWindow;
    libAMT_ConvScrolledDialogPlayer.runChoice = libAMT_ConvDefaultChoiceCallback;
    libAMT_ConvScrolledDialogPlayer.checkCondition = libAMT_ConvCheckNodeConditionsGeneric;
    libAMT_ConvScrolledDialogPlayer.runAction = libAMT_ConvRunNodeActionsGeneric;
    libAMT_ConvScrolledDialogPlayer.UITemplate = null;
    libAMT_ConvBriefingPlayer.skipPrompt = libAMT_ConvDefaultSkipPromptCallback;
    libAMT_ConvBriefingPlayer.init = libAMT_ConvDefaultInitCallback;
    libAMT_ConvBriefingPlayer.close = libAMT_ConvDefaultCloseCallback;
    libAMT_ConvBriefingPlayer.runLine = libAMT_ConvDefaultLineCallback;
    libAMT_ConvBriefingPlayer.runChoice = libAMT_ConvDefaultChoiceCallback;
    libAMT_ConvBriefingPlayer.checkCondition = libAMT_ConvCheckNodeConditionsGeneric;
    libAMT_ConvBriefingPlayer.runAction = libAMT_ConvRunNodeActionsGeneric;
    libAMT_ConvBriefingPlayer.UITemplate = null;
}

//--------------------------------------------------------------------------------------------------
// Custom Script: Init ConvType Array
//--------------------------------------------------------------------------------------------------
void libAMT_InitConvTypeArray()
{
    int i;
    libB513D0A0_gv_conversationTypeArray[0] = "Default";
    libB513D0A0_gv_conversationTypeArray[1] = "ConversationType:";
    libB513D0A0_gv_conversationTypeArray[2] = "ConversationType:Ambient";
    libB513D0A0_gv_conversationTypeArray[3] = "ConversationType:Briefing";
    libB513D0A0_gv_conversationTypeArray[4] = "ConversationType:Conversation";
    libB513D0A0_gv_conversationTypeArray[5] = "ConversationType:CutScene";
    libB513D0A0_gv_conversationTypeArray[6] = "ConversationType:Debrief";
    libB513D0A0_gv_conversationTypeArray[7] = "ConversationType:Installer";
    libB513D0A0_gv_conversationTypeArray[8] = "ConversationType:Mission";
    libB513D0A0_gv_conversationTypeArray[9] = "ConversationType:Pitch";
    libB513D0A0_gv_conversationTypeArray[10]= "ConversationType:ScriptedScenes";
    libB513D0A0_gv_conversationTypeArray[11]= "ConversationType:UnitVO";
    libB513D0A0_gv_conversationTypeArray[12]= "ConversationType:Fidget";
    libB513D0A0_gv_conversationTypeArray[13]= "ConversationType:Generic";
    libB513D0A0_gv_conversationTypeArray[14]= "ConversationType:Gossip";
    libB513D0A0_gv_conversationTypeArray[15]= "ConversationType:Prerendered";
    libB513D0A0_gv_conversationTypeArray[16]= "ConversationType:TVReports";
    for(i=0;i<17;i+=1)
    {
        DataTableSetInt(true,libB513D0A0_gv_conversationMapPrefix+libB513D0A0_gv_conversationTypeArray[i],i);
    }
    
}

//--------------------------------------------------------------------------------------------------
// Custom Script: Top Bar Energy Property Change Implementation
//--------------------------------------------------------------------------------------------------
void libAMT_gf_TriggerAddEventTopBarEnergyPropChange(trigger t,string template,int prop)
{
    
    string eventName = "AMTEventTopBarPropertyEnergyChange ";
    int i;
   
    if (prop == c_unitPropEnergy) 
    {
        eventName = (eventName + "Current");
    }
    else if (prop == c_unitPropEnergyMax) 
    {
         eventName = (eventName + "Max");
    }
    else if (prop == c_unitPropEnergyRegen) 
    {
        eventName = (eventName + "Regen");
    }
    else {
        return;
    }
    eventName = (eventName + " ");
    TriggerAddEventGeneric(t,eventName+IntToString(i)+" "+template);
}
int libAMT_gf_EventPlayerTopBar()
{
    return StringToInt(StringWord(EventGenericName(),3));
}
int libAMT_gf_EventPropTopBarEnergyPropChange()
{
    string eventName = EventGenericName();
    string prop = StringWord(eventName, 2);
    if (prop == "Current") {
        return c_unitPropEnergy;
    }
    else if (prop == "Max") {
        return c_unitPropEnergyMax;
    }
    else if (prop == "Regen") {
        return c_unitPropEnergyRegen;
    }
    else {
        return -1;
    }
}
string libAMT_gf_EventUserTopBarEnergyPropChange()
{
    return StringWord(EventGenericName(),4);
}

//--------------------------------------------------------------------------------------------------
// Custom Script: Top Bar Cancel/Fire Event Implementation
//--------------------------------------------------------------------------------------------------
void libAMT_gf_TriggerAddEventTopBarCancelled(trigger t,int player,string ability)
{
    int ab_i = libNtve_gf_UserDataInstanceGetIndex("AMTTopBarExtendedAbilty",ability);
    int i;
    int ab_e;
    int ab_s;
    if(player == c_playerAny)
    {
        i = 0;
    }
    else
    {
        i = player;
        player += 1;
    }
    if(ab_i == -1 || ability == null || ability == "")
    {
        ab_i = 1;
        ab_e = UserDataInstanceCount("AMTTopBarExtendedAbilty")+1;
    }
    else
    {
        ab_e = ab_i+1;
    }
    ab_s = ab_i;
    while(i!=player)
    {
        TriggerAddEventGeneric(t,"AMTTargetingEventCancel "+UserDataInstance("AMTTopBarExtendedAbilty",ab_i)+" "+IntToString(i));
        ab_i+=1;
        if(ab_i == ab_e)
        {
            i+=1;
            ab_i = ab_s;
        }
    }
}
string libAMT_gf_EventAbilityTopBar()
{
    return StringWord(EventGenericName(),2);
}
void libAMT_gf_TriggerAddEventTopBarFired(trigger t,int player,string ability)
{
    int ab_i = libNtve_gf_UserDataInstanceGetIndex("AMTTopBarExtendedAbilty",ability);
    int i;
    int ab_e;
    int ab_s;
    if(player == c_playerAny)
    {
        i = 0;
    }
    else
    {
        i = player;
        player += 1;
    }
    if(ab_i == -1 || ability == null || ability == "")
    {
        ab_i = 1;
        ab_e = UserDataInstanceCount("AMTTopBarExtendedAbilty")+1;
    }
    else
    {
        ab_e = ab_i+1;
    }
    ab_s = ab_i;
    while(i!=player)
    {
        TriggerAddEventGeneric(t,"AMTTargetingEventFired "+UserDataInstance("AMTTopBarExtendedAbilty",ab_i)+" "+IntToString(i));
        ab_i+=1;
        if(ab_i == ab_e)
        {
            i+=1;
            ab_i = ab_s;
        }
    }
}

