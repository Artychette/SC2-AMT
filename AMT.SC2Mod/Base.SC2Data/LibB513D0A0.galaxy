    }

    lv_workingGroup = DataTableGetUnitGroup(true, ("AMT_PQP_P" + IntToString(EventPlayer()) + "_ProgT" + (libNtve_gf_TriggeringProgressUpgrade())));
    UnitGroupRemove(lv_workingGroup, EventUnit());
    DataTableValueRemove(true, ("AMT_PQP_ProgPT" + IntToString(UnitGetTag(EventUnit()))));
