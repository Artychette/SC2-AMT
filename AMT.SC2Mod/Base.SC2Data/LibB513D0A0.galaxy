    libAMT_gv_Rand_unifi_FG_factor[95] = 61614;
    libAMT_gv_Rand_unifi_FG_factor[96] = 27686;
    libAMT_gv_Rand_unifi_FG_factor[97] = 16694;
    libAMT_gv_Rand_unifi_FG_factor[98] = 59430;
    libAMT_gv_Rand_unifi_FG_factor[99] = 6261;
    libAMT_gv_Rand_unifi_FG_factor[100] = 550;
}
////////////////////////////////////
///// Default Generators ///////////
////////////////////////////////////
int libAMT_gf_Rand_Unifi(int min, int max)
{
    // M.E. O'neill 's PCG algorithm
    // use Knuth LCG + self-XOR + rotation (based on the last LCG output's first bits)
    int seed;
    int count = (libAMT_gv_Rand_unifi_seed>>29)&0x7;
    int range = max - min +1;
    if (range <= 1) {return min;}
    libAMT_gv_Rand_unifi_seed =1664525*libAMT_gv_Rand_unifi_seed + 1013904223 ; // Knuth's 32bit magic numbers
    seed = libAMT_gv_Rand_unifi_seed;
    seed = seed^( (seed<<6)|(0x7FFFFFFF&(seed>>26)) );
    seed = (0x7FFFFFFF&(seed >> count)) | (seed<<(32-count)); 
    seed &= 0x7FFFFFFF; 
    return (seed%range)+min;
        
}
int libAMT_gf_Rand_UnifiFG(int min, int max)
{
    int seed;
    int count;
    int range = max - min +1;
    if (range <= 1) {return min;}
    if( range <= 100)
    {
        libAMT_gv_Rand_unifiFG_seed = (libAMT_gv_Rand_unifi_FG_factor[range]*libAMT_gv_Rand_unifiFG_seed) % 65537;
        return (0xFFFF&libAMT_gv_Rand_unifiFG_seed)%range;
    }
    else
    {
        // regular rand_int
        count = (libAMT_gv_Rand_unifi_seed>>29)&0x7;
        libAMT_gv_Rand_unifi_seed =1664525*libAMT_gv_Rand_unifi_seed + 1013904223  ;
        seed = libAMT_gv_Rand_unifi_seed;
        seed = seed^( (seed<<6)|(0x7FFFFFFF&(seed>>26)) );
        seed = (0x7FFFFFFF&(seed >> count)) | (seed<<(32-count)); 
        seed &= 0x7FFFFFFF; 
        
        return (seed%range)+min;
        
    }
}
fixed libAMT_gf_Rand_Uniff(fixed min, fixed max)
{
    // same base as the int version
    fixed res;
    int seed;
    int count = (libAMT_gv_Rand_uniff_seed>>29)&0x7;
    fixed range = max - min;
    if (range <= 0.0) {return min;}
    libAMT_gv_Rand_uniff_seed =1664525*libAMT_gv_Rand_uniff_seed + 1013904223;  // Knuth's 32bit magic numbers
    seed = libAMT_gv_Rand_uniff_seed;
    seed = seed^( (seed<<6)|(0x7FFFFFFF&(seed>>26)) );
    seed = (0x7FFFFFFF&(seed >> count)) | (seed<<(32-count)); 
    res = IntToFixed(0xFFFF&(seed>>16))*16.0;
    res += IntToFixed(0xFFFF&seed)/4096.0;
    res = res%range;
    while(res < 0){ res+=range;} 
    return res+min;
}
point libAMT_gf_Rand_UnifDisk(point center, fixed radius)
{
    point output;
    fixed Radi_SRoot = 0;
    fixed A;
    fixed B = libAMT_gf_Rand_Uniff(0.0,360.0);
    radius = AbsF(radius);
    if (radius >= 724.0) //overflow safety
    { radius = SquareRoot(radius); Radi_SRoot = radius; }
    A = libAMT_gf_Rand_Uniff(0.0,radius*radius);
    A = SquareRoot(A);
    if(Radi_SRoot != 0) { A*=Radi_SRoot; }
    output = Point(A*Cos(B)+PointGetX(center),A*Sin(B)+PointGetY(center));
    return output;
}
//backward compatibility
int libB513D0A0_gf_RandomShellSerialNumber()
{
    return libAMT_gf_Rand_Unifi(10000,999999);
}

