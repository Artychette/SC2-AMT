string[64] digit7_t;
string libAMT_CodeIntToString(int i)
{   
    string output = "";
    while(i!=0)
    {   
        output = digit7_t[i&0x3F]+output;
        i = 0x7FFFFFFF&(i>>6);
    }
    return output;
}
