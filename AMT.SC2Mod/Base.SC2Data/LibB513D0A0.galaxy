point libB513D0A0_gf_ConvertSegmenttoVector_2D (point lp_start, point lp_end) {
    // Variable Declarations
    point lv_res;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_res = Point((PointGetX(lp_end) - PointGetX(lp_start)), (PointGetY(lp_end) - PointGetY(lp_start)));
    return lv_res;
}

point libB513D0A0_gf_NormalizeVector (point lp_vector) {
    // Variable Declarations
    point lv_res;
    fixed lv_norm;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_norm = DistanceBetweenPoints(lp_vector, Point(0.0, 0.0));

    // Implementation
    lv_res = Point((PointGetX(lp_vector) / lv_norm), (PointGetY(lp_vector) / lv_norm));
    return lv_res;
}

point libB513D0A0_gf_VectorFromPointToUnit (point lp_point, unit lp_unit) {
    // Variable Declarations
    point lv_res;
    point lv_unitPos;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_unitPos = UnitGetPosition(lp_unit);

    // Implementation
    lv_res = Point((PointGetX(lv_unitPos) - PointGetX(lp_point)), (PointGetY(lv_unitPos) - PointGetY(lp_point)));
    return lv_res;
}

fixed libB513D0A0_gf_InnerProduct (point lp_u, point lp_v) {
    // Variable Declarations
    fixed lv_res;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_res = ((PointGetX(lp_u) * PointGetX(lp_v)) + (PointGetY(lp_u) * PointGetY(lp_v)));
    return lv_res;
}

