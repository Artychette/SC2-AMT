    void libAMT_Vectorplayergroup_refill(playergroup value, libAMT_VectorRef vec)
    {   
        int i;
        int lv_size = vec.lv_size;
        for(i=0; i<lv_size; i+=1)
        {   
            DataTableSetPlayerGroup(vec.lv_scope,vec.lv_id_prefix+IntToString(i),value);
        }
    }
    void libAMT_Vectorplayergroup_resize_fill(int size,playergroup value, libAMT_VectorRef vec)
    {   
        int i;
        int lv_size = vec.lv_size;
        if(size<0){ size=0; }
        if(lv_size == size){ return; }
        if(lv_size < size)
        {
            for(i=lv_size; i<size; i+=1)
            {   
                DataTableSetPlayerGroup(vec.lv_scope,vec.lv_id_prefix+IntToString(i),value);
            }
        }
        else
        {
            for(i=size; i<lv_size; i+=1)
            {   
                DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
            }
        }
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,size);
        vec.lv_size = size;
    }
    void libAMT_Vectorplayergroup_push_back(playergroup value, libAMT_VectorRef vec)
    {   
        int lv_size = vec.lv_size;
        DataTableSetPlayerGroup(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size),value);
        lv_size +=1;
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        vec.lv_size = lv_size;
    }
    playergroup libAMT_Vectorplayergroup_pop_back(libAMT_VectorRef vec)
    {   
        int lv_size = MaxI(0,DataTableGetInt(vec.lv_scope,vec.lv_size_prefix)-1);
        playergroup value = DataTableGetPlayerGroup(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size));
        DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size));
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        return value;
    }
    void libAMT_Vectorplayergroup_copy(libAMT_VectorRef src, libAMT_VectorRef tar)
    {
        int i;
        int src_size = src.lv_size;
        int tar_size = tar.lv_size;
        for(i=0; i<src_size; i+=1)
        {   
            DataTableSetPlayerGroup(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetPlayerGroup(src.lv_scope,src.lv_id_prefix+IntToString(i)));
        }
        if(tar_size>src_size)
        {
            for(i=src_size; i<tar_size; i+=1)
            {   
                DataTableValueRemove(tar.lv_scope,tar.lv_id_prefix+IntToString(i));
            }
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,src_size);
        tar.lv_size = src_size;
