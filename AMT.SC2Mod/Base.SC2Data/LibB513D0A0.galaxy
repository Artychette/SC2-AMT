    //
    // Vector<string> Definitions 
    //
    void libAMT_Vectorstring_new(int size, string value,bool scope, libAMT_VectorRef vec)
    {   
        libAMT_Vector new_vec;
        int i;
        int lv_size = MaxI(0,size);
        string id_suffix;
        // clear old storage
        new_vec.lv_id = vec.lv_id;
        new_vec.lv_id_prefix = vec.lv_id_prefix;
        new_vec.lv_size_prefix = vec.lv_size_prefix;
        new_vec.lv_scope = vec.lv_scope;
        new_vec.lv_size = vec.lv_size;
        libAMT_Vector_delete(new_vec);
        // Generate new ID
        AMTVEC_RANDOM_NAME_SEED = 1664525*AMTVEC_RANDOM_NAME_SEED + 1013904223; // Knuth's LCG magic numbers
        vec.lv_id = libAMT_CodeIntToString(AMTVEC_RANDOM_NAME_SEED)+"_";
        vec.lv_id_prefix = AMTVEC_ID_PREFIX+vec.lv_id;
        vec.lv_size_prefix = AMTVEC_SIZE_PREFIX+vec.lv_id;
        vec.lv_scope = scope;
        vec.lv_size = lv_size;
        //init new container
        DataTableSetInt(scope,vec.lv_size_prefix,lv_size);
        for(i=0; i<lv_size;i+=1)
        {
            DataTableSetString(scope,vec.lv_id_prefix+IntToString(i),value);
        }
    }
    string libAMT_Vectorstring_get(int index, libAMT_VectorRef vec)
    {   
        return DataTableGetString(vec.lv_scope,vec.lv_id_prefix+IntToString(index));
    }
    void libAMT_Vectorstring_set(int index,string value, libAMT_VectorRef vec)
    {   
        DataTableSetString(vec.lv_scope,vec.lv_id_prefix+IntToString(index), value);
    }
    void libAMT_Vectorstring_refill(string value, libAMT_VectorRef vec)
    {   
        int i;
        int lv_size = vec.lv_size;
        for(i=0; i<lv_size; i+=1)
        {   
            DataTableSetString(vec.lv_scope,vec.lv_id_prefix+IntToString(i),value);
        }
    }
    void libAMT_Vectorstring_resize_fill(int size,string value, libAMT_VectorRef vec)
    {   
        int i;
        int lv_size = vec.lv_size;
        if(size<0){ size=0; }
        if(lv_size == size){ return; }
        if(lv_size < size)
        {
            for(i=lv_size; i<size; i+=1)
            {   
                DataTableSetString(vec.lv_scope,vec.lv_id_prefix+IntToString(i),value);
            }
        }
        else
        {
            for(i=size; i<lv_size; i+=1)
            {   
                DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
            }
        }
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,size);
        vec.lv_size = size;
    }
    void libAMT_Vectorstring_push_back(string value, libAMT_VectorRef vec)
    {   
        int lv_size = vec.lv_size;
        DataTableSetString(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size),value);
        lv_size +=1;
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        vec.lv_size = lv_size;
    }
    string libAMT_Vectorstring_pop_back(libAMT_VectorRef vec)
    {   
        int lv_size = MaxI(0,DataTableGetInt(vec.lv_scope,vec.lv_size_prefix)-1);
        string value = DataTableGetString(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size));
        DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size));
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        return value;
    }
    void libAMT_Vectorstring_copy(libAMT_VectorRef src, libAMT_VectorRef tar)
    {
        int i;
        int src_size = src.lv_size;
        int tar_size = tar.lv_size;
        for(i=0; i<src_size; i+=1)
        {   
            DataTableSetString(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetString(src.lv_scope,src.lv_id_prefix+IntToString(i)));
        }
        if(tar_size>src_size)
        {
            for(i=src_size; i<tar_size; i+=1)
            {   
                DataTableValueRemove(tar.lv_scope,tar.lv_id_prefix+IntToString(i));
            }
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,src_size);
        tar.lv_size = src_size;
    }
    void libAMT_Vectorstring_append(libAMT_VectorRef src, libAMT_VectorRef tar)
    {
        int i;
        int j;
        int src_size = src.lv_size;
        int tar_size = tar.lv_size;
        i = tar_size;
        for(j=0; j<src_size; j+=1)
        {   
            DataTableSetString(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetString(src.lv_scope,src.lv_id_prefix+IntToString(j)));
            i+=1;
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,tar_size+src_size);
        tar.lv_size += src_size;
    }
