    void libAMT_Vectorunit_refill(unit value, libAMT_VectorRef vec)
    {   
        int i;
        int lv_size = vec.lv_size;
        for(i=0; i<lv_size; i+=1)
        {   
            DataTableSetUnit(vec.lv_scope,vec.lv_id_prefix+IntToString(i),value);
        }
    }
    void libAMT_Vectorunit_resize_fill(int size,unit value, libAMT_VectorRef vec)
    {   
        int i;
        int lv_size = vec.lv_size;
        if(size<0){ size=0; }
        if(lv_size == size){ return; }
        if(lv_size < size)
        {
            for(i=lv_size; i<size; i+=1)
            {   
                DataTableSetUnit(vec.lv_scope,vec.lv_id_prefix+IntToString(i),value);
            }
        }
        else
        {
            for(i=size; i<lv_size; i+=1)
            {   
                DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
            }
        }
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,size);
        vec.lv_size = size;
    }
    void libAMT_Vectorunit_push_back(unit value, libAMT_VectorRef vec)
    {   
        int lv_size = vec.lv_size;
        DataTableSetUnit(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size),value);
        lv_size +=1;
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        vec.lv_size = lv_size;
