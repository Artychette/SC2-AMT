bool libB513D0A0_gt_MouseScroll_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_topOffset;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_topOffset = DataTableGetInt(true, ("ATMCOMMSliderOffset"));

    // Actions
    if (!runActions) {
        return true;
    }

    if ((DataTableGetInt(true, ("ATMCOMMCumulHeight")) <= (libB513D0A0_gv_innerFrameHeight + 15))) {
