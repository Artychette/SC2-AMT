    {   
        int lv_size = vec.lv_size;
        DataTableSetWaveInfo(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size),value);
        lv_size +=1;
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        vec.lv_size = lv_size;
