void libB513D0A0_gf_AMTPQPHelperExcludeIncludeBuilderBuiltfromProductionQueuePanelForPlayer (string lp_builderTrainer, string lp_builtTrainee, int lp_player, bool lp_excludeIncludeBack) {
    // Automatic Variable Declarations
    // Implementation
    if ((CatalogEntryIsValid(c_gameCatalogUnit, lp_builderTrainer) == false) && (CatalogEntryIsValid(c_gameCatalogUnit, lp_builtTrainee) == false) && (CatalogEntryIsValid(c_gameCatalogUpgrade, lp_builtTrainee) == false)) {
        return ;
    }
    else if ((CatalogEntryIsValid(c_gameCatalogUnit, lp_builtTrainee) == false) && (CatalogEntryIsValid(c_gameCatalogUpgrade, lp_builtTrainee) == false)) {
        if ((lp_excludeIncludeBack == false)) {
            DataTableSetBool(true, ("AMT_PQP_Exclude_P" + IntToString(lp_player) + "_" + (lp_builderTrainer) + "_any"), true);
        }
        else {
            DataTableValueRemove(true, ("AMT_PQP_Exclude_P" + IntToString(lp_player) + "_" + (lp_builderTrainer) + "_any"));
        }
    }
    else if ((CatalogEntryIsValid(c_gameCatalogUnit, lp_builderTrainer) == false)) {
        if ((lp_excludeIncludeBack == false)) {
            DataTableSetBool(true, ("AMT_PQP_Exclude_P" + IntToString(lp_player) + "_any_" + (lp_builtTrainee)), true);
        }
        else {
            DataTableValueRemove(true, ("AMT_PQP_Exclude_P" + IntToString(lp_player) + "_any_" + (lp_builtTrainee)));
        }
    }
    else if (true) {
        if ((lp_excludeIncludeBack == false)) {
            DataTableSetBool(true, ("AMT_PQP_Exclude_P" + IntToString(lp_player) + "_" + (lp_builderTrainer) + "_" + (lp_builtTrainee)), true);
        }
        else {
            DataTableValueRemove(true, ("AMT_PQP_Exclude_P" + IntToString(lp_player) + "_" + (lp_builderTrainer) + "_" + (lp_builtTrainee)));
        }
    }
}

