        for(i = 0; i< src.lv_start; i+=1)
        {
            DataTableSetConversation(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetConversation(src.lv_scope,src.lv_id_prefix+IntToString(src_i)));
