    void libAMT_Vector_clear(libAMT_VectorRef vec)
    {   
        int i;
        int size = vec.lv_size;
        for(i=0; i<size;i+=1)
        {
           DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
        }
        DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,0);
        vec.lv_size=0;
    }
    void libAMT_Vector_pop_back(libAMT_VectorRef vec)
    {   
        int lv_size = vec.lv_size;
        if(lv_size>0)
        {
            lv_size-=1;
            DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(lv_size));
            DataTableSetInt(vec.lv_scope,vec.lv_size_prefix,lv_size);
        }
    }
    void libAMT_Vector_delete(libAMT_VectorRef vec)
    {   
        int i;
        int size = vec.lv_size;
        if(vec.lv_id_prefix == null || vec.lv_id_prefix == ""){ return; }
        for(i=0; i<size;i+=1)
        {
           DataTableValueRemove(vec.lv_scope,vec.lv_id_prefix+IntToString(i));
        }
        DataTableValueRemove(vec.lv_scope,vec.lv_size_prefix);
    }
