    void libAMT_Vectorplayergroup_new(int size, playergroup value,bool scope, libAMT_VectorRef vec)
    {   
        libAMT_Vector new_vec;
        int i;
        int lv_size = MaxI(0,size);
        string id_suffix;
        // clear old storage
        new_vec.lv_id = vec.lv_id;
        new_vec.lv_id_prefix = vec.lv_id_prefix;
        new_vec.lv_size_prefix = vec.lv_size_prefix;
        new_vec.lv_scope = vec.lv_scope;
        new_vec.lv_size = vec.lv_size;
        libAMT_Vector_delete(new_vec);
        // Generate new ID
        AMTVEC_RANDOM_NAME_SEED = 1664525*AMTVEC_RANDOM_NAME_SEED + 1013904223; // Knuth's LCG magic numbers
        vec.lv_id = libAMT_CodeIntToString(AMTVEC_RANDOM_NAME_SEED)+"_";
        vec.lv_id_prefix = AMTVEC_ID_PREFIX+vec.lv_id;
        vec.lv_size_prefix = AMTVEC_SIZE_PREFIX+vec.lv_id;
        vec.lv_scope = scope;
        vec.lv_size = lv_size;
        //init new container
        DataTableSetInt(scope,vec.lv_size_prefix,lv_size);
        for(i=0; i<lv_size;i+=1)
        {
            DataTableSetPlayerGroup(scope,vec.lv_id_prefix+IntToString(i),value);
        }
    }
    playergroup libAMT_Vectorplayergroup_get(int index, libAMT_VectorRef vec)
    {   
        return DataTableGetPlayerGroup(vec.lv_scope,vec.lv_id_prefix+IntToString(index));
    }
    void libAMT_Vectorplayergroup_set(int index,playergroup value, libAMT_VectorRef vec)
    {   
        DataTableSetPlayerGroup(vec.lv_scope,vec.lv_id_prefix+IntToString(index), value);
