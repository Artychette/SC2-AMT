        B.lv_id_prefix = buff;
        buff = A.lv_size_prefix;
        A.lv_size_prefix = B.lv_size_prefix;
        B.lv_size_prefix = buff;
        A.lv_scope = B.lv_scope;
        B.lv_scope = scopebuff;
        A.lv_size = B.lv_size;
        B.lv_size = size;
