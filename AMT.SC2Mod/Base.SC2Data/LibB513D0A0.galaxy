    void libAMT_Dequedoodad_copy(libAMT_DequeRef src, libAMT_DequeRef tar)
    {
        int i;
        int src_i = src.lv_start;
        for(i = tar.lv_start; i< tar.lv_size+tar.lv_start; i+=1)
        {
            DataTableValueRemove(tar.lv_scope,tar.lv_id_prefix+IntToString(i));
        }

        for(i = 0; i< src.lv_start; i+=1)
        {
            DataTableSetDoodad(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetDoodad(src.lv_scope,src.lv_id_prefix+IntToString(src_i)));
            src_i +=1;
