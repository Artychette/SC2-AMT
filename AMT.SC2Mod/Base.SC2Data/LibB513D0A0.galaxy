    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(UnitGroupUnit(UnitGroupSelected(EventPlayer()), 1)), "Test", lv_inputString, c_animFlagPlayForever, c_animTimeDefault);
    return true;
