    lv_s = ModI(lv_q, 10);
    lv_q = ((lv_q - lv_s) / 10);
    DataTableValueRemove(true, ("AMT_PQP_P" + IntToString(EventPlayer()) + "_ProgT" + (libNtve_gf_TriggeringProgressUpgrade())));
    DataTableValueRemove(true, ("AMT_PQP_P" + IntToString(EventPlayer()) + "_Q" + IntToString(lv_q) + "_S_" + IntToString(lv_s)));
    DataTableValueRemove(true, ("AMT_PQP_P" + IntToString(EventPlayer()) + "_ProgSlot" + (libNtve_gf_TriggeringProgressUpgrade())));
    libB513D0A0_gf_AMTPQPHelperShowHidePlayerSlot(lv_s, lv_q, EventPlayer(), false);
    return true;
}

