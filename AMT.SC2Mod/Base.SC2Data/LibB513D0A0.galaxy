    void libAMT_Dequefixed_copy(libAMT_DequeRef src, libAMT_DequeRef tar)
    {
        int i;
        int src_i = src.lv_start;
        for(i = tar.lv_start; i< tar.lv_size+tar.lv_start; i+=1)
        {
            DataTableValueRemove(tar.lv_scope,tar.lv_id_prefix+IntToString(i));
        }

        for(i = 0; i< src.lv_start; i+=1)
        {
            DataTableSetFixed(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetFixed(src.lv_scope,src.lv_id_prefix+IntToString(src_i)));
            src_i +=1;
        }

        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,src.lv_size);
        tar.lv_size = src.lv_size;
        DataTableSetInt(tar.lv_scope,tar.lv_start_prefix,0);
        tar.lv_start = 0;
    }
    void libAMT_Dequefixed_append(libAMT_DequeRef src, libAMT_DequeRef tar)
    {
        int i;
        int j;
        int src_size = src.lv_size;
        int tar_size = tar.lv_size;
        i = tar_size+tar.lv_start;
        for(j=src.lv_start; j<src_size+src.lv_start; j+=1)
        {   
            DataTableSetFixed(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetFixed(src.lv_scope,src.lv_id_prefix+IntToString(j)));
            i+=1;
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,src_size);
        tar.lv_size = src_size;
    }
