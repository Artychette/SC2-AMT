            DataTableSetTransmissionSource(tar.lv_scope,tar.lv_id_prefix+IntToString(i),DataTableGetTransmissionSource(src.lv_scope,src.lv_id_prefix+IntToString(j)));
            i+=1;
        }
        DataTableSetInt(tar.lv_scope,tar.lv_size_prefix,tar_size+src_size);
        tar.lv_size += src_size;
    }
