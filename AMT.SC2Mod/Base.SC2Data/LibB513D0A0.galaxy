bool libB513D0A0_gf_MouseWheelUsedScrolledWindow (bool lp_runActions, bool lp_checkConditions) {
    // Variable Declarations
    fixed lv_bottomOffset;
    int lv_clampHeight;
    int lv_maxHeight;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bottomOffset = DataTableGetInt(true, ("AMT_ConvDefaultScrolledWindowCurrentHeight" + IntToString(EventPlayer())));
    lv_clampHeight = DataTableGetInt(true,"AMT_ConvDefaultScrolledWindowClampHeight"+IntToString(EventPlayer()));
    lv_maxHeight = DataTableGetInt(true,"AMT_ConvDefaultScrolledWindowMaxHeight"+IntToString(EventPlayer()));

    // Implementation
    if (lp_checkConditions && !(TriggerIsEnabled(TriggerGetCurrent()))) {
        return false;
    }

    if (!(lp_runActions)) {
        return true;
    }

    if ((lv_maxHeight <= lv_clampHeight)) {
        return false;
    }

    lv_bottomOffset += (30.0 * EventMouseWheelSpin());
    lv_bottomOffset = MaxF(0.0, MinF(lv_bottomOffset, (lv_maxHeight - lv_clampHeight)));
    DataTableSetInt(true,"AMT_ConvDefaultScrolledWindowCurrentHeight"+IntToString(EventPlayer()),RoundI(lv_bottomOffset));
    libNtve_gf_SetDialogItemCurrentValue(DataTableGetControl(true,"AMT_ConvDefaultScrolledWindowScrollControl_"+IntToString(EventPlayer())), RoundI(lv_bottomOffset), PlayerGroupSingle(EventPlayer()));
    libB513D0A0_gf_ApplyEntryPortraitVisibility(EventPlayer());
    return true;
}

