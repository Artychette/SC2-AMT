<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <Frame type="CommandButton" name="SoACommandButtonTemplate" template="CommandButton/CommandButtonTemplate">
        <!--Width val="76"/>
        <Height val="76"/>
        
        <Frame type="Image" name="GameButtonBorderImage">
            <LayerCount val="2"/>
