<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Frame type="Button" name="OverlayButtonTemplate">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <Label val="Label"/>
        <HitTestFrame val="HitTestFrame"/>
        <ClickSound val="@UI_ActionButtonSelect"/>
        <Height val="66"/>
        <Width val="296"/>

        <Frame type="Image" name="NormalImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/LoTV_Shared_StoryButtonNormal"/>
            <TextureType val="EndCap"/>
            <Tiled val="false"/>
            <StateCount val="3"/>
            <DesaturateOnDisable val="false"/>
            <DescFlags val="Internal"/>
            
            <Animation name="Disabled">
                <Event event="OnDisabled" action="Reset,Play" frame="$parent"/>	
                <Event event="OnEnabled" action="Reset" frame="$parent"/>
                <Controller type="Texture" end="Pause">
                    <Key type="Image" time="0.0" image="@UI/LoTV_Shared_StoryButtonDisabled"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/LoTV_Shared_StoryButtonHover"/>
            <TextureType val="EndCap"/>
            <Tiled val="false"/>
            <StateCount val="3"/>
            <DescFlags val="Internal"/>
        </Frame>
        
        <Frame type="Image" name="HighlightImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Texture val="@UI/LoTV_Shared_StoryButton_HighlightCallout"/>
            <TextureType val="EndCap"/>
            <Tiled val="false"/>
            <StateCount val="1"/>
            <DesaturateOnDisable val="false"/>
            <Visible val="false"/>
            <RenderPriority val="515"/>
            <Animation name="Highlight">
                <Event event="Highlight" action="Reset" frame="$parent"/>
                <Event event="Highlight" action="Play" frame="$parent"/>
                <Controller type="Fade" end="PingPong">
                    <Key type="Curve" time="0" value="0" out="Slow"/>
                    <Key type="Curve" time="1" value="255" out="Slow"/>
                    <Key type="Curve" time="2" value="0" in="Slow"/>
                </Controller>
            </Animation>
            <Animation name="HighlightVisibility">
                <Event event="Highlight" action="Reset" frame="$parent"/>
                <Event event="Highlight" action="Play" frame="$parent"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="true"/>
                </Controller>
            </Animation>
            <Animation name="HighlightVisibilityOff">
                <Event event="HighlightStop" action="Reset" frame="$parent"/>
                <Event event="HighlightStop" action="Play" frame="$parent"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0" value="false"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Label" name="Label">
            <Anchor side="Top" relative="$parent" pos="Min" offset="4"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Style val="Void_StoryButtonLabel"/>
            <DescFlags val="Internal"/>
            <RenderPriority val="516"/>
        </Frame>

        <Frame type="Frame" name="HitTestFrame">
            <TooltipAnchorPosition val="TopCenter"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <DescFlags val="Internal"/>
        </Frame>
    </Frame>


    <Frame type="Portrait" name="TargetingOverlayTemplate">
        <Visible val="False"/>
        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
        <AcceptsMouse val="false"/>
        <RenderType val="HDR"/>        
        <UseTransition val="False"/>
        <BackgroundImage val="BackgroundImage"/>
        <ModelLink val="SOA_Calldown_UI"/>
        
        <Frame type="Image" name="BackgroundImage">
            <Visible val="false"/>
            <DescFlags val="Internal"/>
        </Frame>
        <Animation name="Show">
            <Event event="TargetingOverlayShow" action="Reset,Play"/>
            <Controller type="Visibility" end="Stop">
                <Key type="Bool" time="0.0" value="False"/>
                <Key type="Bool" time="0.0" value="True"/>
            </Controller>
            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0.0" sound="@UI_SOA_calldown_on1"/>
                <Key type="Sound" time="0.5" sound="@UI_SOA_calldown_on2"/>
            </Controller>
             <Controller type="Fade" end="Pause">
                 <Key type="Curve" time="0" value="0" out="Slow"/>
                 <Key type="Curve" time=".35" value="255" in="Slow"/>
             </Controller>
        </Animation>
        <Animation name="Hide">
            <Event event="TargetingOverlayHide" action="Reset,Play"/>
            <Controller type="Visibility" end="Stop">
                <Key type="Bool" time="0.0" value="True"/>
                <Key type="Bool" time="0.4" value="False"/>
            </Controller>
            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0.0" sound="@UI_SOA_calldown_on1"/>
                <!--Key type="Sound" time="0.5" sound="@UI_SOA_calldown_on2"/-->
            </Controller>
             <Controller type="Fade" end="Pause">
                 <Key type="Curve" time="0" value="255" out="Slow"/>
                 <Key type="Curve" time=".35" value="0" in="Slow"/>
             </Controller>
        </Animation>
    </Frame>

    <Frame type="Frame" name="ChargesTemplate">
        <Width val="76"/>
        <Height val="76"/>
        <Visible val="False"/>

        <Frame type="Image" name="Charge">
            <Anchor side="Top" relative="$parent" Pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" Pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent" Pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" Pos="Mid" offset="0"/>
            <Width val="76"/>
            <Height val="76"/>
            <Texture val="@UI/LotV_Mission_SoA_Charge"/>

            <Animation name="Bump">
                <Event event="Bump" action="Reset,Play" frame="$parent"/>
                 <Controller type="Dimension" dimension="Width" relative="true" percentage="True" end="Pause" >
                     <Key type="Curve" time="0" value="0" out="Slow"/>
                     <Key type="Curve" time="0.125" value="-20" in="Slow" out="Slow"/>
                     <Key type="Curve" time=".25" value="0" in="Slow"/>
                 </Controller>
                 <Controller type="Dimension" dimension="Height" relative="true" percentage="True" end="Pause" >
                     <Key type="Curve" time="0" value="0" out="Slow"/>
                     <Key type="Curve" time="0.125" value="-20" in="Slow" out="Slow"/>
                     <Key type="Curve" time=".25" value="0" in="Slow"/>
                 </Controller>
            </Animation>
            <Animation name="Show">
                <Event event="OnShown" action="Reset" frame="$parent"/>
                <Event event="OnShown" action="Play" frame="$parent"/>
                <Event event="Refresh" action="Play" frame="$parent"/>
                <Event event="Consume" action="Pause" frame="$parent"/>
                 <Controller type="Fade" end="Pause">
                     <Key type="Curve" time="0" value="0" out="Slow"/>
                     <Key type="Curve" time=".125" value="255" in="Slow"/>
                 </Controller>
                 <Controller type="Dimension" dimension="Width" relative="False" percentage="False" end="Pause" >
                     <Key type="Curve" time="0" value="1" in="linear" out="linear"/>
                     <Key type="Curve" time="0.75" value="35" in="linear" out="linear"/>
                     <Key type="Curve" time="1" value="76" in="linear" out="linear"/>
                 </Controller>
                 <Controller type="Dimension" dimension="Height" relative="False" percentage="False" end="Pause" >
                     <Key type="Curve" time="0" value="1" in="linear" out="linear"/>
                     <Key type="Curve" time="0.75" value="35" in="linear" out="linear"/>
                     <Key type="Curve" time="1" value="76" in="linear" out="linear"/>
                 </Controller>
            </Animation>
            <Animation name="Hide">
                <Event event="Consume" action="Reset" frame="$parent"/>
                <Event event="Consume" action="Play" frame="$parent"/>
                 <Controller type="Fade" end="Pause">
                     <Key type="Curve" time="0" value="255" out="linear"/>
                     <Key type="Curve" time="0" value="0" in="linear"/>
                 </Controller>
            </Animation>
        </Frame>
        
        <Frame type="Image" name="ChargePulse">
            <Anchor side="Top" relative="$parent/Charge" Pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/Charge" Pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/Charge" Pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent/Charge" Pos="Mid" offset="0"/>
            <Texture val="@UI/LotV_Mission_SoA_Charge_Pulse"/>
            <Width val="76"/>
            <Height val="76"/>

            <Animation name="Bump">
                <Event event="Bump" action="Reset,Play" frame="$parent"/>
                 <Controller type="Dimension" dimension="Width" relative="true" percentage="True" end="Pause" >
                     <Key type="Curve" time="0" value="0" out="Slow"/>
                     <Key type="Curve" time="0.125" value="-20" in="Slow" out="Slow"/>
                     <Key type="Curve" time=".25" value="0" in="Slow"/>
                 </Controller>
                 <Controller type="Dimension" dimension="Height" relative="true" percentage="True" end="Pause" >
                     <Key type="Curve" time="0" value="0" out="Slow"/>
                     <Key type="Curve" time="0.125" value="-20" in="Slow" out="Slow"/>
                     <Key type="Curve" time=".25" value="0" in="Slow"/>
                 </Controller>
            </Animation>
            <Animation name="Show">
                <Event event="OnShown" action="Reset" frame="$parent"/>
                <Event event="OnShown" action="Play" frame="$parent"/>
                <Event event="Refresh" action="Play" frame="$parent"/>
                <Event event="Consume" action="Pause" frame="$parent"/>
                 <Controller type="Dimension" dimension="Width" relative="False" percentage="True" end="Loop" >
                     <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                     <Key type="Curve" time="1" value="50" in="linear" out="linear"/>
                     <Key type="Curve" time="2" value="100" in="linear" out="linear"/>
                     <Key type="Curve" time="3" value="100" in="linear" out="linear"/>
                 </Controller>
                 <Controller type="Dimension" dimension="Height" relative="False" percentage="True" end="Loop" >
                     <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                     <Key type="Curve" time="1" value="50" in="linear" out="linear"/>
                     <Key type="Curve" time="2" value="100" in="linear" out="linear"/>
                     <Key type="Curve" time="3" value="100" in="linear" out="linear"/>
                 </Controller>
                 <Controller type="Fade" end="Loop">
                     <Key type="Curve" time="0" value="255" out="Slow"/>
                     <Key type="Curve" time="2" value="255" in="Slow"/>
                     <Key type="Curve" time="3" value="0" in="Slow"/>
                 </Controller>
            </Animation>
            <Animation name="Hide">
                <Event event="Consume" action="Reset" frame="$parent"/>
                <Event event="Consume" action="Play" frame="$parent"/>
                 <Controller type="Fade" end="Pause">
                     <Key type="Curve" time="0" value="255" out="Slow"/>
                     <Key type="Curve" time="0.05" value="0" in="Slow"/>
                 </Controller>
            </Animation>
        </Frame>
        
        <Frame type="Image" name="ChargeRing1">
            <Anchor side="Top" relative="$parent/Charge" Pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent/Charge" Pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent/Charge" Pos="Mid" offset="0"/>
