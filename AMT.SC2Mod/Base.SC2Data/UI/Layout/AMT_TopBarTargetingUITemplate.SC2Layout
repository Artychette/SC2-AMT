                     <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                     <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                     <Key type="Curve" time=".5" value="50" in="linear" out="linear"/>
                     <Key type="Curve" time=".75" value="100" in="linear" out="linear"/>
                 </Controller>
                 <Controller type="Dimension" dimension="Height" relative="False" percentage="True" end="Pause" >
                     <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                     <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                     <Key type="Curve" time=".5" value="50" in="linear" out="linear"/>
                     <Key type="Curve" time=".75" value="100" in="linear" out="linear"/>
                 </Controller>
                 <Controller type="Rotation" end="Loop" relative="false">
                     <Key type="Curve" time="0.0" value="0" in="Linear" out="Linear"/>
