    <Frame type="CommandPanel" name="ZergCommandPanelTemplate" template="AMT_TopBarTemplate/TopBarCommandPanelTemplate">

        <Frame type="CommandTooltip" name="ZergCommandTooltip" template="CommandButton/CommandTooltipTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="120"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-225"/>
        </Frame>

        <Frame type="CommandTooltip" name="ZergCommandTooltipB" template="CommandButton/CommandTooltipTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="160"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-225"/>
        </Frame>

        <Frame type="CommandTooltip" name="ZergCommandTooltipC" template="CommandButton/CommandTooltipTemplate">
