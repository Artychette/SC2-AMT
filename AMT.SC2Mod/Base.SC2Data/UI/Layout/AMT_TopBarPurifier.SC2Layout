<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>   

    <!-- CONSTANTS -->
    <Constant name="Fenix_UnitButton_ActiveState_Alpha" val="100"/>
    <Constant name="Fenix_UnitStatusBar_Container_Width" val="72"/>
    <Constant name="Fenix_UnitStatusBar_Width" val="72"/>
    <Constant name="Fenix_UnitStatusBar_Width_Half" val="36"/>
    <Constant name="Fenix_UnitStatusBar_Height" val="5"/>
    <Constant name="Fenix_UnitStatusBar_Spacing" val="2"/>
    <Constant name="Fenix_UnitStatusBar_Underlay_Color" val="c17000"/>
    <Constant name="Fenix_UnitStatusBar_Health_Color_Dark" val="214d12"/>
    <Constant name="Fenix_UnitStatusBar_Health_Color_Light" val="69da39"/>
    <Constant name="Fenix_UnitStatusBar_Shields_Color_Dark" val="0d3282"/>
    <Constant name="Fenix_UnitStatusBar_Shields_Color_Light" val="0096ff"/>
    <Constant name="Fenix_UnitStatusBar_Energy_Color_Dark" val="270a36"/>
    <Constant name="Fenix_UnitStatusBar_Energy_Color_Light" val="ea5eff"/>
    <Constant name="Fenix_Sparkle_Color" val="ff890b"/>
    
    <!-- SPARKLE ANIMATION TEMPLATES -->
    
    <!-- Base Sparkle -->
    
    <Frame type="Image" name="SparkleItemBaseTemplate">
        <Width val="4"/>
        <Height val="40"/>
        <Color val="#Fenix_Sparkle_Color"/>
        
        <Animation name="Show">
            <Event event="AnimationStart" action="Reset,Play"/>
             
            <Controller type="Anchor" end="Loop" side="Top" relative="true">
                <Key type="Curve" time="0" value="0" out="Fast"/>
                <Key type="Curve" time="2" value="-150" in="Slow"/>
            </Controller>
            
            <Controller type="Fade" end="Loop">
                <Key type="Curve" time="0" value="60" out="Fast"/>
                <Key type="Curve" time="1.5" value="0" in="Slow"/>
                <Key type="Curve" time="2" value="0" in="Slow"/>
            </Controller>
        </Animation>
    </Frame>
    
    <Frame type="Image" name="SparkleItemTemplate1" template="AMT_TopBarPurifier/SparkleItemBaseTemplate">
        <Width val="4"/>
    </Frame>
    
    <Frame type="Image" name="SparkleItemTemplate2" template="AMT_TopBarPurifier/SparkleItemBaseTemplate">
        <Width val="2"/>
    </Frame>
    
    <Frame type="Frame" name="SparkleContainerTemplate">
        <Visible val="False"/>
        
        <Frame type="Image" name="SparkleItem01" template="AMT_TopBarPurifier/SparkleItemTemplate1">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-30"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-30"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem02" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="10"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="10"/>
        </Frame>
        
