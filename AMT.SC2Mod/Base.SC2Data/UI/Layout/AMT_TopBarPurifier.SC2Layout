            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-21"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-21"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem04" template="AMT_TopBarPurifier/SparkleItemTemplate1">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="22"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="22"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem05" template="AMT_TopBarPurifier/SparkleItemTemplate2">
