            <Anchor side="Left" relative="$parent" pos="Mid" offset="31"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="31"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem06" template="AMT_TopBarPurifier/SparkleItemTemplate1">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-5"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-5"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem07" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="21"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="21"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem08" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-15"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-15"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem09" template="AMT_TopBarPurifier/SparkleItemTemplate1">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="12"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="12"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem10" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-17"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-17"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem11" template="AMT_TopBarPurifier/SparkleItemTemplate1">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="23"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="23"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem12" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-9"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-9"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem13" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="18"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="18"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem14" template="AMT_TopBarPurifier/SparkleItemTemplate1">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-28"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-28"/>
        </Frame>
        
        <Frame type="Image" name="SparkleItem15" template="AMT_TopBarPurifier/SparkleItemTemplate2">
            <Anchor side="Top" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-25"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-25"/>
        </Frame>
        
        <Animation name="StartAnimation">
            <Event event="OnShown" action="Reset,Play"/>
             
            <Controller type="Event" end="Stop" frame="SparkleItem01">
                <Key type="Event" time="0" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem02">
                <Key type="Event" time=".2" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem03">
                <Key type="Event" time=".4" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem04">
                <Key type="Event" time=".6" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem05">
                <Key type="Event" time=".8" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem06">
                <Key type="Event" time="1" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem07">
                <Key type="Event" time="1.2" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem08">
                <Key type="Event" time="1.4" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem09">
                <Key type="Event" time="1.6" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem10">
                <Key type="Event" time="1.8" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem11">
                <Key type="Event" time="2" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem12">
                <Key type="Event" time="2.2" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem13">
                <Key type="Event" time="2.4" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem14">
                <Key type="Event" time="2.6" event="AnimationStart"/>
            </Controller>
             
            <Controller type="Event" end="Stop" frame="SparkleItem15">
                <Key type="Event" time="2.7" event="AnimationStart"/>
            </Controller>
        </Animation>
    </Frame>
    

    <!-- COMMAND BUTTON TEMPLATES -->
    <Frame type="CommandButton" name="PurifierCommandButtonTemplate" template="AMT_TopBarTemplate/TopBarCommandButtonTemplate">
        <Width val="90"/>
        <Height val="90"/>
        <!--
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        -->
        <ClickSound val="@UI_GenericButton"/>

        <Frame type="Image" name="GameButtonBorderImage">
            <Visible val="False"/>
        </Frame>

        <Frame type="Image" name="NormalImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="7"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-7"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="7"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-7"/>
            <LayerCount val="3"/>
            <TextureType val="Normal" layer="0"/>
            <LayerAlpha val="0" layer="0" />
            <LayerVisible val="False" layer="0" />
            <!--
            <TextureCoords top="0.0" left="0.0" bottom="0.01" right="0.01" layer="0"/>
            -->
            <TextureType val="Normal" layer="1"/>
            <TextureCoords top="0.0" left="0.0" bottom="0.125" right="0.0625" layer="1"/>
            <Texture val="@UI/ButtonCooldown" layer="1"/>
            <LayerAlpha val="255" layer="1"/>
            <LayerColor val="255,150,0" layer="1"/>
            <AnimColumns val="16" layer="1"/>
            <AnimCount val="128" layer="1"/>
            <Animating val="True" layer="1"/>
            <ManagedAnim val="False" layer="1"/>
            <LayerVisible val="False" layer="1" />
            <TextureType val="Normal" layer="2"/>
            <TextureCoords top="0.0" left="0.0" bottom="0.125" right="0.0625" layer="2"/>
            <Texture val="Assets/Textures/White.dds" layer="2"/>
            <LayerAlpha val="255" layer="2"/>
            <AnimColumns val="16" layer="2"/>
            <AnimCount val="128" layer="2"/>
            <Animating val="True" layer="2"/>
            <ManagedAnim val="False" layer="2"/>
            <LayerVisible val="False" layer="2" />
            <RenderPriority val="512"/>
            <DescFlags val=""/>
            
            <StateGroup name="Visibility">
                <DefaultState val="Visible"/>
                
                <State name="Locked">
                    <When type="AnimationState" frame="$parent" UnlockState="Locked"/>
                    <Action type="SetProperty" frame="$this" index="0" TextureCoords="0.0,0.0,0.01,0.01"/>
                </State>

                <State name="NotVisible">
                    <When type="AnimationState" frame="$parent" ActiveState="True"/>
                    <Action type="SetProperty" frame="$this" Alpha="#Fenix_UnitButton_ActiveState_Alpha"/>
                </State>
                
                <State name="Visible">
                    <Action type="SetProperty" frame="$this" Alpha="255"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor side="Top" relative="$parent" pos="Min" offset="7"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-7"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="7"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-7"/>
            <LayerCount val="3"/>
            <TextureType val="Normal" layer="0"/>
            <LayerAlpha val="0" layer="0" />
            <!--
            <TextureCoords top="0.0" left="0.0" bottom="0.01" right="0.01" layer="0"/>
            -->
            <TextureType val="Normal" layer="1"/>
            <TextureCoords top="0.0" left="0.0" bottom="0.125" right="0.0625" layer="1"/>
            <Texture val="@UI/ButtonCooldown" layer="1"/>
            <AnimColumns val="16" layer="1"/>
            <AnimCount val="128" layer="1"/>
            <Animating val="True" layer="1"/>
            <ManagedAnim val="False" layer="1"/>
            <LayerVisible val="False" layer="1" />
            <TextureType val="Normal" layer="2"/>
            <TextureCoords top="0.0" left="0.0" bottom="0.125" right="0.0625" layer="2"/>
            <Texture val="@UI/ButtonCooldownCharge" layer="2"/>
            <AnimColumns val="16" layer="2"/>
            <AnimCount val="128" layer="2"/>
            <Animating val="True" layer="2"/>
            <ManagedAnim val="False" layer="2"/>
            <LayerVisible val="False" layer="2" />
            <RenderPriority val="512"/>
            <DescFlags val=""/>
            
            <StateGroup name="Visibility">
                <DefaultState val="Visible"/>
                
                <State name="Locked">
                    <When type="AnimationState" frame="$parent" UnlockState="Locked"/>
                    <Action type="SetProperty" frame="$this" index="0" TextureCoords="0.0,0.0,0.01,0.01"/>
                </State>

                <State name="NotVisible">
                    <When type="AnimationState" frame="$parent" ActiveState="True"/>
                    <Action type="SetProperty" frame="$this" Alpha="#Fenix_UnitButton_ActiveState_Alpha"/>
                </State>
                
                <State name="Visible">
                    <Action type="SetProperty" frame="$this" Alpha="255"/>
                </State>
            </StateGroup>
        </Frame>

        <Frame type="Image" name="AutoCastImage">
            <Anchor relative="$parent"/>
            <TextureType val="Normal" layer="0"/>
            <TextureCoords top="0.0" left="0.0" bottom="0.25" right="0.125" layer="0"/>
            <Texture val="@UI/ButtonAutocast" layer="0"/>
            <AnimColumns val="8" layer="0"/>
            <AnimCount val="32" layer="0"/>
            <AnimDuration val="1000" layer="0"/>
            <Animating val="True" layer="0"/>
            <ManagedAnim val="True" layer="0"/>
            <LayerVisible val="False" layer="0" />
            <RenderPriority val="514"/>
        </Frame>
        
        <Frame type="Label" name="CooldownLabel">
            <Anchor side="Top" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-5"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-5"/>
            <Style val="GameButtonCooldown"/>
            <RenderPriority val="516"/>
        </Frame>

        <Frame type="Label" name="ChargeLabel">
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-8"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-8"/>
            <Style val="GameButtonCharge"/>
            <RenderPriority val="516"/>
        </Frame>

        <Frame type="Image" name="CooldownFinishedImage">
            <Anchor relative="$parent"/>
            <TextureCoords top="0.0" left="0.0" bottom="1" right="0.125"/>
            <Texture val="@UI/ButtonCoolDownBurst"/>
            <AnimDuration val="250"/>
            <AnimColumns val="8"/>
            <AnimCount val="8"/>
            <Animating val="true"/>
            <ManagedAnim val="true"/>
            <LoopingAnim val="false"/>
            <RenderPriority val="518"/>
            <BlendMode val="Add"/>
        </Frame>

        <Frame type="CommandHotkeyFrame" name="HotkeyFrame" template="StandardTemplates/HotkeyFrameTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="6"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="6"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <RenderPriority val="520"/>

            <Frame type="Image" name="HotkeyLabelBackground">
                <RenderPriority val="520"/>
            </Frame>

            <Frame type="Label" name="HotkeyLabel">
                <RenderPriority val="520"/>
            </Frame>
        </Frame>

        <Frame type="Image" name="FenixButtonInactiveImage">
            <Anchor relative="$parent"/>
            <LayerCount val="1"/>
            <TextureType val="Normal" layer="0"/>
            <!--
            <RenderPriority val="510"/>
            -->
            <Texture val="Assets\Textures\ui_battlenet_glue_orangepulldown_listbackground.dds" layer="0"/>
            <Visible val="false"/>
        </Frame>
        
        <Frame type="Image" name="FenixButtonActiveImage">
            <Anchor relative="$parent"/>
            <TextureType val="Normal" layer="0"/>
            <TextureCoords top="0.0" left="0.0" bottom="0.25" right="0.125" layer="0"/>
            <Texture val="@UI/FenixButtonActiveImage" layer="0"/>
            <AnimColumns val="8" layer="0"/>
            <AnimCount val="32" layer="0"/>
            <AnimDuration val="1000" layer="0"/>
            <Animating val="True" layer="0"/>
            <ManagedAnim val="True" layer="0"/>
            <LayerVisible val="True" layer="0" />
            <!--
            <RenderPriority val="614"/>
            -->
            <Visible val="false"/>
        </Frame>
        
        <Frame type="Image" name="ButtonBorder">
            <Anchor relative="$parent"/>
            <LayerCount val="1"/>
            <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Button_Normal" layer="0"/>
            <TextureType val="NineSlice" layer="0"/>
            <RenderPriority val="600"/>
            <Alpha val="255"/>
            
            <Animation name="Hover">
                <Event event="OnMouseEnter" action="Reset,Play" frame="$parent"/>
                <Event event="OnMouseExit" action="Reset,Stop" frame="$parent"/>
                 
                <Controller type="Texture" end="Pause">
                    <Key type="Image" time="0" image="@UI/SC2_UI_Coop_Fenix_TopBar_Button_Hover"/>
                </Controller>
            </Animation>
            
            <StateGroup name="Visibility">
                <DefaultState val="Visible"/>
                
                <State name="Locked">
                    <When type="AnimationState" frame="$parent" UnlockState="Locked"/>
                    <Action type="SetProperty" frame="$this" Alpha="#Fenix_UnitButton_ActiveState_Alpha"/>
                </State>

                <State name="NotVisible">
                    <When type="AnimationState" frame="$parent" ActiveState="True"/>
                    <Action type="SetProperty" frame="$this" Alpha="#Fenix_UnitButton_ActiveState_Alpha"/>
                </State>
                
                <State name="Visible">
                    <Action type="SetProperty" frame="$this" Alpha="255"/>
                </State>
            </StateGroup>
        </Frame>
        
        <Frame type="Image" name="LockImage">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="2"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="2"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Width val="60"/>
            <ScaleHeightToTexture val="True"/>
            <Texture val="@UI/SC2_UI_Collection_Icon_Locked"/>
            <ColorAdjustMode val="Colorize"/>
            <DarkAdjustColor val="255,155,0"/>
            <Alpha val="#Fenix_UnitButton_ActiveState_Alpha"/>
            
            <StateGroup name="Visibility">
                <DefaultState val="NotVisible"/>
                
                <State name="Visible">
                    <When type="AnimationState" frame="$parent" UnlockState="Locked"/>
                    <Action type="SetProperty" frame="$this" Visible="True"/>
                </State>
                
                <State name="NotVisible">
                    <Action type="SetProperty" frame="$this" Visible="False"/>
                </State>
            </StateGroup>
        </Frame>
        
        <Frame type="Frame" name="ReadyAnimationContainer" template="AMT_TopBarPurifier/SparkleContainerTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-12"/>
            <Anchor side="Left" relative="$parent" pos="Min" offset="10"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-10"/>
            <RenderPriority val="510"/>
        </Frame>
        
        <StateGroup name="Active">
            <DefaultState val="Inactive"/>

            <State name="Active">
                <When type="AnimationState" frame="$this" ActiveState="True"/>
            </State>
            
            <State name="Inactive"/>
        </StateGroup>
    </Frame>

    <Frame type="CommandPanel" name="PurifierCommandPanelTemplate" template="AMT_TopBarTemplate/TopBarCommandPanelTemplate">
        
        <!-- DECORATIVE BACKGROUND STUFF -->
        <Frame type="Frame" name="FluffContainer">
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Width val="300"/>
            <Height val="150"/>
            
            <Frame type="Image" name="Filigree_Corner_BottomLeft">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="-27"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="1"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_BottomCorner"/>
                <TextureCoords top="0" left="1" bottom="1" right="0" layer="0"/>
            </Frame>
            
            <Frame type="Image" name="Filigree_Corner_BottomRight">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="-27"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="-1"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_BottomCorner"/>
                <TextureCoords top="0" left="0" bottom="1" right="1" layer="0"/>
            </Frame>
            
            <Frame type="Image" name="Filigree_Corner_TopLeft">
                <Anchor side="Top" relative="$parent" pos="Min" offset="11"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="1"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_TopCorner"/>
                <TextureCoords top="0" left="1" bottom="1" right="0" layer="0"/>
            </Frame>
            
            <Frame type="Image" name="Filigree_Corner_TopRight">
                <Anchor side="Top" relative="$parent" pos="Min" offset="11"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="-1"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_TopCorner"/>
                <TextureCoords top="0" left="0" bottom="1" right="1" layer="0"/>
            </Frame>
            
            <Frame type="Image" name="Filigree_Center_TopLeft">
                <Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
                <Anchor side="Left" relative="$parent" pos="Min" offset="38"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_Top"/>
                <TextureCoords top="0" left="1" bottom="1" right="0" layer="0"/>
            </Frame>
            
            <Frame type="Image" name="Filigree_Center_TopRight">
                <Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
                <Anchor side="Right" relative="$parent" pos="Max" offset="-38"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_Top"/>
                <TextureCoords top="0" left="0" bottom="1" right="1" layer="0"/>
            </Frame>
            
            <Frame type="Image" name="Filigree_Center_Bottom">
                <Anchor side="Bottom" relative="$parent" pos="Max" offset="-27"/>
                <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
                <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
                <Texture val="@UI/SC2_UI_Coop_Fenix_TopBar_Filigree_Bottom"/>
            </Frame>
        </Frame>
        
        
        <!-- POWERSUIT 1 FRAMES -->
        <Frame type="CommandButton" name="CommandButton00" template="AMT_TopBarTemplate/TopBarCommandButtonTemplate">
            <Height val="90"/>
            <Width val="90"/>
            <Anchor side="Top" relative="$parent/CommandButton01" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$this" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent/Commandbutton01" pos="Min" offset="-10"/>
            <ClickSound val="*@UI_SoA_SpellClick"/>
        </Frame>        
        
        <Frame type="Image" name="LockedImage00">
            <Anchor relative="$parent/CommandButton00"/>
            <Texture val="Assets\Textures\ui_void_mission_soa_frame_ability_lock.dds"/>
            <Animation name="Show">
                <Event event="OnHidden" action="Reset" frame="$parent/CommandButton00"/>
                <Event event="OnHidden" action="Play" frame="$parent/CommandButton00"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0.0" value="true"/>
                </Controller>
            </Animation>
            <Animation name="Hide">
                <Event event="OnShown" action="Reset" frame="$parent/CommandButton00"/>
                <Event event="OnShown" action="Play" frame="$parent/CommandButton00"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0.0" value="false"/>
                </Controller>
            </Animation>
        </Frame>

        
        
        <!-- POWERSUIT 2 FRAMES -->
        <Frame type="CommandButton" name="CommandButton01" template="AMT_TopBarTemplate/TopBarCommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="20"/>
            <Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Height val="90"/>
            <Width val="90"/>

            <ClickSound val="*@UI_SoA_SpellClick"/>
        </Frame>        
        
        <Frame type="Image" name="LockedImage01">
            <Anchor relative="$parent/CommandButton01"/>
            <Texture val="Assets\Textures\ui_void_mission_soa_frame_ability_lock.dds"/>
            <Animation name="Show">
                <Event event="OnHidden" action="Reset" frame="$parent/CommandButton01"/>
                <Event event="OnHidden" action="Play" frame="$parent/CommandButton01"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0.0" value="true"/>
                </Controller>
            </Animation>
            <Animation name="Hide">
                <Event event="OnShown" action="Reset" frame="$parent/CommandButton01"/>
                <Event event="OnShown" action="Play" frame="$parent/CommandButton01"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0.0" value="false"/>
                </Controller>
            </Animation>
        </Frame>
        
        <!-- POWERSUIT 3 FRAMES -->
        <Frame type="CommandButton" name="CommandButton02" template="AMT_TopBarTemplate/TopBarCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/CommandButton01" pos="Min" offset="0"/>
            <Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent/Commandbutton01" pos="Max" offset="10"/>
            <Anchor side="Right" relative="$this" pos="Min" offset="0"/>
            <ClickSound val="*@UI_SoA_SpellClick"/>
            <Height val="90"/>
            <Width val="90"/>
            
        </Frame>
        
        <Frame type="Image" name="LockedImage02">
            <Anchor relative="$parent/CommandButton02"/>
            <Texture val="Assets\Textures\ui_void_mission_soa_frame_ability_lock.dds"/>
            <Animation name="Show">
                <Event event="OnHidden" action="Reset" frame="$parent/CommandButton02"/>
                <Event event="OnHidden" action="Play" frame="$parent/CommandButton02"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0.0" value="true"/>
                </Controller>
            </Animation>
            <Animation name="Hide">
                <Event event="OnShown" action="Reset" frame="$parent/CommandButton02"/>
                <Event event="OnShown" action="Play" frame="$parent/CommandButton02"/>
                <Controller type="Visibility" end="Pause">
                    <Key type="Bool" time="0.0" value="false"/>
                </Controller>
            </Animation>
        </Frame>

    </Frame>
    
    <!-- CONTAINER TEMPLATE -->
    <Frame type="Frame" name="PurifierTopBarTemplate" template="AMT_TopBarTemplate/TopBarCutsceneFrameTemplate">

        <Frame type="Frame" name="ConsoleSound" template="AMT_TopBarTemplate/ProtossConsoleSound">
        </Frame>
        <Frame type="CutsceneFrame" name="CalldownCutscene">
            <File val="Cutscenes/UI_FenixCastingPanel.SC2Cutscene"/>
        </Frame>
        
        <Frame type="Frame" name="CommandCardHolder">
            <Frame type="CommandPanel" name="PurifierCommandPanel" template="AMT_TopBarPurifier/PurifierCommandPanelTemplate">
            </Frame>
            
        </Frame>
        <Frame type="Frame" name="HighlightArrow00" template="AMT_TopBarTemplate/ProtossAbilityArrowsTemplate">
            <Anchor side="Top" relative="$parent/CommandCardHolder/PurifierCommandPanel/CommandButton00" pos="Max" offset="15"/>
            <Anchor side="Left" relative="$parent/CommandCardHolder/PurifierCommandPanel/CommandButton00" pos="Mid" offset="-38"/>            
        </Frame>
        <Frame type="Frame" name="HighlightArrow01" template="AMT_TopBarTemplate/ProtossAbilityArrowsTemplate">
            <Anchor side="Top" relative="$parent/CommandCardHolder/PurifierCommandPanel/CommandButton01" pos="Max" offset="15"/>
            <Anchor side="Left" relative="$parent/CommandCardHolder/PurifierCommandPanel/CommandButton01" pos="Mid" offset="-38"/>    
        </Frame>
        <Frame type="Frame" name="HighlightArrow02" template="AMT_TopBarTemplate/ProtossAbilityArrowsTemplate">
            <Anchor side="Top" relative="$parent/CommandCardHolder/PurifierCommandPanel/CommandButton02" pos="Max" offset="15"/>
            <Anchor side="Left" relative="$parent/CommandCardHolder/PurifierCommandPanel/CommandButton02" pos="Mid" offset="-38"/>    
        </Frame>
    </Frame>
</Desc>