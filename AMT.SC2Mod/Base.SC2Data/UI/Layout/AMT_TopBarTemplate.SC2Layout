<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

<!--                             -->
<!-- Game UI Top frame insertion -->
<!--                             -->

    <Frame type="Frame" name="GameUI/UIContainer/FullscreenUpperContainer" file="GameUI">
        
        <Frame type="Frame" name="AMTGlobalCastingPanel">
            <Width val="786"/>
            <Height val="225"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-393"/>
            <RenderPriority val="500"/>
            <CollapseLayout val="true"/>
            <PreserveAnchorOffset val="true"/>
            <Visible val="false"/>
        </Frame>
    </Frame>


<!--                    -->
<!-- In/Out Sound Frame -->
<!--                    -->

    <Frame type="Frame" name="ProtossConsoleSound">
        
        <Animation name="ConsoleInPlay">
            <Event event="OnHidden" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/CinematicModeIndicator"/>  
            <Event event="OnShown" action="Reset,Play" frame="$this"/>  
            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0" sound="@UI_ConsoleIn_Prot"/>
            </Controller>
        </Animation>
        <Animation name="ConsoleOutPlay">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/CinematicModeIndicator"/> 
            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0" sound="@UI_ConsoleOut_Prot"/>
            </Controller>    
        </Animation>
        <Animation name="KillInSoundOnVictory">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/VictoryPanelIndicator"/> 
            <Controller type="Animation" end="Stop" frame="$this" animation="ConsoleInPlay">
                <Key type="Animation" time="0" action="Stop"/>
            </Controller>    
        </Animation>
        <Animation name="KillOutSoundOnVictory">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/VictoryPanelIndicator"/> 
            <Controller type="Animation" end="Stop" frame="$this" animation="ConsoleOutPlay">
                <Key type="Animation" time="0" action="Stop"/>
            </Controller>    
        </Animation>
    </Frame>

    <Frame type="Frame" name="TerranConsoleSound">
        
        <Animation name="ConsoleInPlay">
            <Event event="OnHidden" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/CinematicModeIndicator"/>  
            <Event event="OnShown" action="Reset,Play" frame="$this"/>  
            <Controller type="Sound" end="Stop">
