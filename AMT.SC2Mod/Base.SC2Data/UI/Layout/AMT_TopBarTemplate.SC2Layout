            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0" sound="@UI_ConsoleOut_Terr"/>
            </Controller>    
        </Animation>
        <Animation name="KillInSoundOnVictory">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/VictoryPanelIndicator"/> 
            <Controller type="Animation" end="Stop" frame="$this" animation="ConsoleInPlay">
                <Key type="Animation" time="0" action="Stop"/>
            </Controller>    
        </Animation>
        <Animation name="KillOutSoundOnVictory">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/VictoryPanelIndicator"/> 
            <Controller type="Animation" end="Stop" frame="$this" animation="ConsoleOutPlay">
                <Key type="Animation" time="0" action="Stop"/>
            </Controller>    
        </Animation>
    </Frame>

    <Frame type="Frame" name="ZergConsoleSound">
        
        <Animation name="ConsoleInPlay">
            <Event event="OnHidden" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/CinematicModeIndicator"/>  
            <Event event="OnShown" action="Reset,Play" frame="$this"/>  
            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0" sound="@UI_ConsoleIn_Zerg"/>
            </Controller>
        </Animation>
        <Animation name="ConsoleOutPlay">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/CinematicModeIndicator"/> 
            <Controller type="Sound" end="Stop">
                <Key type="Sound" time="0" sound="@UI_ConsoleOut_Zerg"/>
            </Controller>    
        </Animation>
        <Animation name="KillInSoundOnVictory">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/VictoryPanelIndicator"/> 
            <Controller type="Animation" end="Stop" frame="$this" animation="ConsoleInPlay">
                <Key type="Animation" time="0" action="Stop"/>
            </Controller>    
        </Animation>
        <Animation name="KillOutSoundOnVictory">
            <Event event="OnShown" action="Reset,Play" frame="$ancestor[@name=FullscreenUpperContainer]/VictoryPanelIndicator"/> 
            <Controller type="Animation" end="Stop" frame="$this" animation="ConsoleOutPlay">
                <Key type="Animation" time="0" action="Stop"/>
            </Controller>    
        </Animation>
    </Frame>

<!--                           -->
<!-- Arrow Highligth Templates -->
<!--                           -->

    

    <Frame type="Frame" name="ProtossAbilityArrowsTemplate">
        <Width val="76"/>
        <Height val="100"/>
        <Visible val="false"/>

        <Frame type="Image" name="Arrow1Empty">
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
            <ScaleHeightToTexture val="True"/>
            <Texture val="@UI/LotV_Mission_SoA_Frame_Ability_Alert_ArrowEmpty"/>
        </Frame>
        
        <Frame type="Image" name="Arrow1Highlight">
            <Anchor relative="$parent/Arrow1Empty"/>
            <Texture val="@UI/LotV_Mission_SoA_Frame_Ability_Alert_ArrowHighlight"/>

            <Animation name="Show">
                <Event event="OnShown" action="Play"/>
                <Event event="OnShown" action="Reset"/>
                <Controller type="Fade" end="Loop">
                    <Key type="Curve" time="0" value="0" out="Slow"/>
                    <Key type="Curve" time="0.2" value="0" out="Slow"/>
                    <Key type="Curve" time="0.5" value="0" in="Slow"/>
                    <Key type="Curve" time="0.8" value="255" out="Slow"/>
                    <Key type="Curve" time="1.2" value="0" out="Slow"/>
                </Controller>
            </Animation>
          
        </Frame>
        
        <Frame type="Image" name="Arrow2Empty">
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Top" relative="$parent/Arrow1Empty" pos="Max" offset="-43"/>
            <ScaleHeightToTexture val="True"/>
            <Texture val="@UI/LotV_Mission_SoA_Frame_Ability_Alert_ArrowEmpty"/>
        </Frame>
        
        <Frame type="Image" name="Arrow2Highlight">
            <Anchor relative="$parent/Arrow2Empty"/>
            <Texture val="@UI/LotV_Mission_SoA_Frame_Ability_Alert_ArrowHighlight"/>

            <Animation name="Show">
                <Event event="OnShown" action="Play"/>
                <Event event="OnShown" action="Reset"/>
                <Controller type="Fade" end="Loop">
                    <Key type="Curve" time="0.0" value="0" out="Slow"/>
                    <Key type="Curve" time="0.3" value="0" in="Slow"/>
                    <Key type="Curve" time="0.6" value="153" out="Slow"/>
                    <Key type="Curve" time="1.2" value="0" out="Slow"/>
                </Controller>
            </Animation>
          
        </Frame>
        
        <Frame type="Image" name="Arrow3Empty">
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Top" relative="$parent/Arrow2Empty" pos="Max" offset="-43"/>
            <ScaleHeightToTexture val="True"/>
            <Texture val="@UI/LotV_Mission_SoA_Frame_Ability_Alert_ArrowEmpty"/>
        </Frame>
        
        <Frame type="Image" name="Arrow3Highlight">
            <Anchor relative="$parent/Arrow3Empty"/>
            <Texture val="@UI/LotV_Mission_SoA_Frame_Ability_Alert_ArrowHighlight"/>

            <Animation name="Show">
                <Event event="OnShown" action="Play"/>
                <Event event="OnShown" action="Reset"/>
                <Controller type="Fade" end="Loop">
                    <Key type="Curve" time="0.0" value="0" out="Slow"/>
                    <Key type="Curve" time="0.3" value="51" in="Slow"/>
                    <Key type="Curve" time="0.6" value="0" out="Slow"/>
                    <Key type="Curve" time="1.2" value="0" out="Slow"/>
                </Controller>
            </Animation>
        </Frame>
    </Frame>



