<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Frame type="CommandButton" name="TerranCommandButtonTemplate" template="AMT_TopBarTemplate/TopBarCommandButtonTemplate">
    </Frame>

    <Frame type="CommandPanel" name="Terran4SlotCommandPanelTemplate" template="AMT_TopBarTemplate/TopBarCommandPanelTemplate">

        <Frame type="CommandTooltip" name="TopBarCommandTooltip" template="CommandButton/CommandTooltipTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="120"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="-225"/>
        </Frame>

        <Frame type="CommandButton" name="CommandButton00" template="AMT_TopBarTerran/TerranCommandButtonTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="12"/>
            <Anchor side="Bottom" relative="$this" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$this" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-102"/>
            <ClickSound val="*@UI_SoA_SpellClick"/>
        </Frame>        

        <Frame type="CommandButton" name="CommandButton01" template="AMT_TopBarTerran/TerranCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/CommandButton00" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$this" pos="Max" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="-16"/>
            <ClickSound val="*@UI_SoA_SpellClick"/>
        </Frame>       

        <Frame type="CommandButton" name="CommandButton02" template="AMT_TopBarTerran/TerranCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/CommandButton00" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="16"/>
            <Anchor side="Right" relative="$this" pos="Min" offset="0"/>
            <ClickSound val="*@UI_SoA_SpellClick"/>
        </Frame>      

        <Frame type="CommandButton" name="CommandButton03" template="AMT_TopBarTerran/TerranCommandButtonTemplate">
            <Anchor side="Top" relative="$parent/CommandButton00" pos="Min" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="102"/>
            <Anchor side="Right" relative="$this" pos="Min" offset="0"/>
            <ClickSound val="*@UI_SoA_SpellClick"/>
        </Frame>


    </Frame>

	
    <Frame type="CommandPanel" name="Terran2SlotCommandPanelTemplate" template="AMT_TopBarTemplate/TopBarCommandPanelTemplate">

        <Frame type="CommandTooltip" name="TopBarCommandTooltip" template="CommandButton/CommandTooltipTemplate">
            <Anchor side="Top" relative="$parent" pos="Min" offset="120"/>
