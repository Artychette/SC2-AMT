    <Frame type="Frame" name="Terran2SlotTopBarTemplate" template="AMT_TopBarTemplate/TopBarCutsceneFrameTemplate">

        <Frame type="Frame" name="ConsoleSound" template="AMT_TopBarTemplate/TerranConsoleSound">
        </Frame>
        <Frame type="CutsceneFrame" name="CalldownCutscene">            
            <File val="Cutscenes/UI_TerranCastingPanel.SC2Cutscene"/>
            <Animation name="BirthFilter">
                <Event event="OnShown" action="Reset,Play"/>
                <Controller type="Cutscene" end="Stop">
                    <Key type="Cutscene" time="0" action="AddFilter" filter="TwoButtons"/>
                </Controller> 
            </Animation>
        </Frame>     
        
        <Frame type="Frame" name="CommandCardHolder">
            <Frame type="CommandPanel" name="Terran2SlotCommandPanel" template="AMT_TopBarTerran/Terran2SlotCommandPanelTemplate">
            </Frame>
        </Frame>
        
        <Frame type="Frame" name="HighlightArrow00" template="AMT_TopBarTemplate/ProtossAbilityArrowsTemplate">
            <Anchor side="Top" relative="$parent/CommandCardHolder/Terran2SlotCommandPanel/CommandButton00" pos="Max" offset="15"/>
            <Anchor side="Left" relative="$parent/CommandCardHolder/Terran2SlotCommandPanel/CommandButton00" pos="Mid" offset="-38"/>            
        </Frame>
        <Frame type="Frame" name="HighlightArrow01" template="AMT_TopBarTemplate/ProtossAbilityArrowsTemplate">
